def draw_extended_line(ax, p1, p2, color="cyan", lw=2.0, ls="-"):
    """
    畫一條「通過 p1、p2 兩點並往兩側延伸到畫面邊界」的直線。

    為什麼要延伸：觸壁判定用的是「點到直線的垂直距離」，用的是整條無限長的直線，
    不是你點的那兩點之間的線段。把它延伸畫出來，你才看得到程式實際認定的壁在哪，
    才能判斷壁線角度有沒有歪掉。

    回傳畫出來的 artist，方便之後移除。
    """
    (x1, y1), (x2, y2) = p1, p2
    dx, dy = x2 - x1, y2 - y1
    norm = np.hypot(dx, dy)
    if norm < 1e-9:
        return None
    dx, dy = dx / norm, dy / norm          # 單位方向向量

    # 以目前畫面大小為基準，往兩側各延伸一個足夠大的距離
    xlim, ylim = ax.get_xlim(), ax.get_ylim()
    big = 3.0 * (abs(xlim[1] - xlim[0]) + abs(ylim[1] - ylim[0]))

    xs = [x1 - dx * big, x1 + dx * big]
    ys = [y1 - dy * big, y1 + dy * big]

    art, = ax.plot(xs, ys, color=color, linewidth=lw, linestyle=ls, alpha=0.9)

    # 延伸線會把座標軸範圍撐大，所以畫完要把範圍設回原本的影像大小
    ax.set_xlim(xlim)
    ax.set_ylim(ylim)
    return art


class ClickCollector:
    """
    在一張圖上收集指定數量的滑鼠點擊，點滿後「等你按 Enter 確認」才結束。

    為什麼不直接用 plt.ginput：
      ginput 會把「使用工具列縮放/平移時的點擊」也算成一次有效點擊，
      而這些照片很大、常常需要先放大才看得清楚螺絲，所以必須自己擋掉。
      這個類別會檢查工具列目前是不是在 zoom/pan 模式，是的話就忽略那次點擊。

    操作方式：
        左鍵  = 選一個點
        右鍵  = 取消上一個點
        Enter = 確認並進入下一步（必須點滿指定數量才有作用）

    preview_fn：
        一個可選的函式，簽名是 preview_fn(ax, points) -> list of artists。
        每次點擊後若已點滿，就呼叫它把「兩點連成的線」之類的預覽畫出來，
        讓你在按 Enter 前先確認。回傳的 artists 會在下次更新時自動清掉。
    """

    def __init__(self, ax, n_points, label, preview_fn=None):
        self.ax = ax                    # 要在哪個座標軸上收集點擊
        self.n_points = n_points        # 需要收集幾個點
        self.label = label              # 提示文字，顯示在標題上
        self.preview_fn = preview_fn    # 點滿時用來畫預覽的函式
        self.points = []                # 已收集到的點，每個是 (x, y)
        self.markers = []               # 畫在圖上的紅色十字，供反悔時移除
        self.preview_artists = []       # 預覽用的線，每次更新都重畫
        self.confirmed = False          # 是否已按 Enter 確認

    def _toolbar_active(self):
        """回傳工具列是不是正在 zoom 或 pan 模式。"""
        tb = self.ax.figure.canvas.toolbar
        # 不同 matplotlib 版本屬性名稱不同，用 getattr 保險
        mode = getattr(tb, "mode", "")
        return bool(str(mode).strip())

    def _on_click(self, event):
        """每次按下滑鼠鍵時被呼叫。"""
        if event.inaxes is not self.ax:      # 點在圖外（例如工具列）→ 忽略
            return
        if self._toolbar_active():           # 正在縮放/平移 → 忽略
            return

        if event.button == 3:                # 右鍵 = 取消上一個點
            if self.points:
                self.points.pop()
                self.markers.pop().remove()
                self._refresh()
            return

        if event.button != 1:                # 只收左鍵
            return
        if len(self.points) >= self.n_points:
            # 已經點滿了，多餘的左鍵忽略，避免不小心多點
            return

        self.points.append((event.xdata, event.ydata))
        # 畫一個紅色十字標記，讓你看得到點在哪
        m, = self.ax.plot(event.xdata, event.ydata, "r+",
                          markersize=18, markeredgewidth=2.5)
        self.markers.append(m)
        self._refresh()

    def _on_key(self, event):
        """按鍵事件：只處理 Enter。"""
        if event.key not in ("enter", "return"):
            return
        if len(self.points) < self.n_points:
            # 還沒點滿就按 Enter，提醒一下但不關閉
            self._refresh(warn=True)
            return
        self.confirmed = True
        plt.close(self.ax.figure)

    def _refresh(self, warn=False):
        """清掉舊預覽、重畫新預覽、更新標題。"""
        # 先移除上一輪的預覽線
        for a in self.preview_artists:
            try:
                a.remove()
            except Exception:
                pass
        self.preview_artists = []

        # 點滿了就畫預覽，讓你在按 Enter 前確認
        if self.preview_fn is not None and len(self.points) == self.n_points:
            arts = self.preview_fn(self.ax, self.points)
            self.preview_artists = [a for a in (arts or []) if a is not None]

        done = len(self.points) == self.n_points
        if warn:
            tip = T(f"⚠ 還沒點滿（需要 {self.n_points} 點）",
                    f"Not enough points (need {self.n_points})")
        elif done:
            tip = T("✓ 已點滿，確認無誤請按 Enter（右鍵可取消重點）",
                    "Ready - press Enter to confirm (right-click to undo)")
        else:
            tip = T("左鍵=選點，右鍵=取消；工具列可縮放",
                    "left=pick, right=undo; toolbar to zoom")

        self.ax.set_title(f"{self.label}   [{len(self.points)}/{self.n_points}]\n{tip}",
                          fontsize=12)
        self.ax.figure.canvas.draw_idle()

    def run(self):
        """開始收集，阻塞直到按 Enter 確認或視窗被關閉。回傳點的 list。"""
        self._refresh()
        cid1 = self.ax.figure.canvas.mpl_connect("button_press_event", self._on_click)
        cid2 = self.ax.figure.canvas.mpl_connect("key_press_event", self._on_key)
        plt.show(block=True)
        for cid in (cid1, cid2):
            try:
                self.ax.figure.canvas.mpl_disconnect(cid)
            except Exception:
                pass
        return self.points


def collect_points(img_bgr, n_points, label, preview_fn=None, figsize=(13, 10)):
    """
    開一個視窗顯示影像，收集 n_points 個點擊，按 Enter 確認後回傳 [(x,y), ...]。
    座標是「原圖的像素座標」，因為 imshow 用的就是原圖。

    preview_fn 會在點滿時被呼叫，用來畫出連線供你確認。
    """
    fig, ax = plt.subplots(figsize=figsize)
    ax.imshow(cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB))
    ax.set_axis_off()
    fig.tight_layout()
    pts = ClickCollector(ax, n_points, label, preview_fn=preview_fn).run()
    if len(pts) < n_points:
        raise RuntimeError(f"只收到 {len(pts)} 個點，需要 {n_points} 個。視窗被提早關閉了。")
    return pts


def preview_wall(ax, pts):
    """
    筒倉壁的預覽：把通過兩點的『整條直線』延伸畫出來。
    這條線就是程式之後拿來算「點到壁距離」用的那一條。
    """
    arts = []
    line = draw_extended_line(ax, pts[0], pts[1], color="cyan", lw=2.2)
    if line is not None:
        arts.append(line)
    # 把你點的兩點用青色圓圈再標一次，和紅色十字區隔
    a, = ax.plot([pts[0][0], pts[1][0]], [pts[0][1], pts[1][1]],
                 "o", color="cyan", markersize=9, markerfacecolor="none",
                 markeredgewidth=2, linestyle="none")
    arts.append(a)
    return arts


def preview_screw(ax, pts):
    """
    螺絲的預覽：把兩顆螺絲之間的『線段』畫出來，並標上像素長度與換算出的比例尺。
    這裡畫線段而不是無限延伸線，因為用到的是兩點之間的距離，不是一條直線。
    """
    (x1, y1), (x2, y2) = pts
    d_px = np.hypot(x2 - x1, y2 - y1)
    px_per_mm = d_px / SCREW_DISTANCE_MM if SCREW_DISTANCE_MM > 0 else float("nan")

    arts = []
    a, = ax.plot([x1, x2], [y1, y2], "-", color="yellow", linewidth=2.2)
    arts.append(a)
    b, = ax.plot([x1, x2], [y1, y2], "o", color="yellow", markersize=9,
                 markerfacecolor="none", markeredgewidth=2, linestyle="none")
    arts.append(b)

    # 在線段中點標出量到的長度，方便你一眼看出有沒有點歪
    t = ax.text((x1 + x2) / 2, (y1 + y2) / 2,
                f"{d_px:.1f} px = {SCREW_DISTANCE_MM:.1f} mm\n"
                f"{px_per_mm:.3f} px/mm\n"
                f"→ {T('顆粒直徑', 'particle dia')} {PARTICLE_DIAMETER_MM * px_per_mm:.1f} px",
                color="yellow", fontsize=10, ha="center", va="center",
                bbox=dict(boxstyle="round,pad=0.3", fc="black", alpha=0.7))
    arts.append(t)
    return arts


class RectSelectorBox:
    """
    用拖曳的方式framing一個矩形 ROI，拖完按 Enter 確認。

    操作方式：
        按住左鍵拖曳 = 拉出一個框（想重拉就直接再拉一次，新框取代舊框）
        Enter        = 確認

    用 matplotlib 內建的 RectangleSelector。它和工具列的縮放/平移可以並存，
    但同樣要擋掉「縮放模式下的拖曳」，否則一邊縮放一邊會拉出假的框。
    """

    def __init__(self, ax, label):
        self.ax = ax
        self.label = label
        self.extents = None       # (xmin, xmax, ymin, ymax)
        self.confirmed = False
        self.selector = None

    def _toolbar_active(self):
        tb = self.ax.figure.canvas.toolbar
        return bool(str(getattr(tb, "mode", "")).strip())

    def _on_select(self, eclick, erelease):
        """拖曳放開時被呼叫，記下框的範圍。"""
        if self._toolbar_active():
            return
        x0, x1 = sorted([eclick.xdata, erelease.xdata])
        y0, y1 = sorted([eclick.ydata, erelease.ydata])
        # 太小的框當成誤觸，忽略
        if (x1 - x0) < 10 or (y1 - y0) < 10:
            return
        self.extents = (x0, x1, y0, y1)
        self._refresh()

    def _on_key(self, event):
        if event.key not in ("enter", "return"):
            return
        if self.extents is None:
            self._refresh(warn=True)
            return
        self.confirmed = True
        plt.close(self.ax.figure)

    def _refresh(self, warn=False):
        if warn:
            tip = T("⚠ 還沒拉出任何框", "No rectangle drawn yet")
        elif self.extents is not None:
            x0, x1, y0, y1 = self.extents
            tip = T(f"✓ 目前範圍 {int(x1-x0)}×{int(y1-y0)} px，"
                    f"確認請按 Enter（想重拉就直接再拉一次）",
                    f"Current {int(x1-x0)}x{int(y1-y0)} px - Enter to confirm "
                    f"(drag again to redo)")
        else:
            tip = T("按住左鍵拖曳拉出框", "Drag with left button to draw a box")
        self.ax.set_title(f"{self.label}\n{tip}", fontsize=12)
        self.ax.figure.canvas.draw_idle()

    def run(self):
        """開始拖曳選取，阻塞直到按 Enter 確認。回傳 (x0, y0, x1, y1)。"""
        from matplotlib.widgets import RectangleSelector

        self._refresh()
        # interactive=True 讓拉出來的框可以再用拖把手微調
        self.selector = RectangleSelector(
            self.ax, self._on_select,
            useblit=False,                 # 關掉 blit，框才會穩定留在畫面上
            button=[1],                    # 只吃左鍵
            minspanx=5, minspany=5,
            spancoords="pixels",
            interactive=True,
            props=dict(facecolor="red", edgecolor="red",
                       alpha=0.18, fill=True, linewidth=2),
        )
        cid = self.ax.figure.canvas.mpl_connect("key_press_event", self._on_key)
        plt.show(block=True)
        try:
            self.ax.figure.canvas.mpl_disconnect(cid)
        except Exception:
            pass

        if self.extents is None:
            raise RuntimeError("沒有拉出任何 ROI 框，視窗被提早關閉了。")
        x0, x1, y0, y1 = self.extents
        return int(x0), int(y0), int(x1), int(y1)


def select_roi(img_bgr, label, figsize=(13, 10)):
    """開一個視窗，用拖曳的方式選 ROI，按 Enter 確認。回傳 [x0, y0, x1, y1]。"""
    fig, ax = plt.subplots(figsize=figsize)
    ax.imshow(cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB))
    ax.set_axis_off()
    fig.tight_layout()
    return list(RectSelectorBox(ax, label).run())


def get_clicks_for_image(img_bgr, img_name, cache):
    """
    取得一張照片所需的全部手點資料。
    若快取裡已經有這張，就直接用快取；否則依序請你點四組。

    回傳一個 dict：
        roi        = [x0, y0, x1, y1]           分析範圍
        screws     = [[x,y], [x,y]]             兩顆螺絲
        wall_left  = [[x,y], [x,y]]             左壁上兩點
