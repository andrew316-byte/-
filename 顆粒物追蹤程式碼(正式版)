def _plain(o):
    """numpy 型別 → 一般 Python 型別（寫 json 用）。"""
    if isinstance(o, np.generic):
        return o.item()
    raise TypeError(f"無法寫入 json：{type(o)}")


def _run_job(job):
    """一支影片。回傳 dict(ok, folder, video, ...)。失敗時帶回錯誤訊息與 traceback。"""
    global QUIET
    folder, json_path, video_path, out_dir, write_overlay, quiet, prog, key = job
    QUIET = quiet

    def progress(stage, done, total):
        """[v3] 把進度寫進主程式共用的表格 prog（平行跑時才有），主程式會定時印出來。"""
        if prog is not None:
            try:
                prog[key] = (stage, done, total, time.time())
            except Exception:                   # 回報失敗不能害分析中斷
                pass
    lines = []

    def log(msg=""):
        if not quiet:
            print(msg)
        lines.append(msg)

    t0 = time.time()
    video = os.path.splitext(os.path.basename(json_path))[0]
    # [2.2] 從讀標定檔到寫完 video_summary.json 全部包在 try 裡：任何一步出錯都只回報這一支失敗，
    #       不會丟出例外把整批（和其他行程正在跑的影片）一起拖垮。
    try:
        cv2.setNumThreads(1)                   # 平行跑時每個行程只用一條執行緒，避免互搶
        with open(json_path, encoding="utf-8") as f:
            cfg = json.load(f)
        video = cfg.get("video", video)
        out_dir, ev, summary = analyze_one(video_path, cfg, log, out_dir,
                                           do_overlay=write_overlay, legacy_scale=False,
                                           progress=progress)
        log(f"耗時 {time.time() - t0:.0f} s，輸出在 {os.path.basename(out_dir)}")
        summary = dict(summary, folder=folder, seconds=time.time() - t0)
        done_path = os.path.join(out_dir, DONE_MARK)
        # [2.2] 寫入前先檢查：已經有 video_summary.json 代表別的執行已經寫過這支，
        #       不覆寫它，也不改 summary.txt，只把這支記為失敗
        if os.path.exists(done_path):
            raise FileExistsError(f"{done_path} 已經存在（可能同時開了兩次程式），"
                                  "這次的結果沒有寫入，原本的檔案保持不動")
        with open(os.path.join(out_dir, "summary.txt"), "w", encoding="utf-8-sig") as f:
            f.write("\n".join(lines))
        # 最後才寫這個檔：它存在就代表這支影片完整跑完（3_plot.py 也是讀它）
        with open(done_path, "x", encoding="utf-8") as f:
            json.dump(summary, f, ensure_ascii=False, indent=2, default=_plain)
        return dict(ok=True, folder=folder, video=video, P_c=float(summary["P_c"]),
                    flow=float(summary["flow_rate_count"]), n_events=int(summary["n_events"]),
                    seconds=float(summary["seconds"]))
    except Exception as e:
        import traceback
        return dict(ok=False, folder=folder, video=video,
                    error_type=type(e).__name__, message=str(e),
                    traceback=traceback.format_exc(limit=8), seconds=time.time() - t0)


def main():
    import datetime
    import multiprocessing as mp
    import common

    if OVERLAY not in ("first", "all", "none"):
        sys.exit('OVERLAY 只能是 "first"、"all" 或 "none"')
    table, lookup_sha = common.load_lookup()
    folders = FOLDERS if FOLDERS else list(table)
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    os.makedirs(OUT_DIR, exist_ok=True)
    os.makedirs(LOGS_DIR, exist_ok=True)

    jobs, no_labels, done, leftover = [], [], 0, []
    n_frames = {}                                            # [v3] 每支影片要跑的幀數
    for folder in folders:
        meta = common.lookup_folder(table, folder)             # 查不到 → raise
        ldir = os.path.join(LABELS_DIR, folder)
        if not os.path.isdir(ldir):
            no_labels.append(folder)
            continue
        first = True
        for j in sorted(f for f in os.listdir(ldir) if f.lower().endswith(".json")):
            jp = os.path.join(ldir, j)
            with open(jp, encoding="utf-8") as f:
                cfg = json.load(f)
            if VIDEOS and cfg["video"] not in VIDEOS:
                continue
            # alpha / b_mm 必須和對照表一致（防止拿錯標定檔）
            if abs(float(cfg["alpha"]) - meta["alpha"]) > 1e-9:
                raise RuntimeError(f"{folder}/{j}：.json 的 alpha={cfg['alpha']} 與對照表 {meta['alpha']} 不符")
            b_cfg = float(cfg["d_eq_mm"]) / np.sqrt(float(cfg["alpha"]))
            if abs(b_cfg - meta["b_mm"]) > 1e-6:
                raise RuntimeError(f"{folder}/{j}：.json 的 b={b_cfg:.4f} mm 與對照表 {meta['b_mm']} 不符")
            # ROI 下緣必須蓋到「出口線 + 長半軸 + b」，否則出口下方的偵測範圍會被 ROI 切掉
            # [v3] 新版標定檔只有 px_per_mm_preview、沒有 frame_height → 也接受；
            #      frame_height 缺的話直接從影片讀
            s_key = "px_per_mm" if "px_per_mm" in cfg else "px_per_mm_preview"
            if s_key not in cfg:
                raise RuntimeError(f"{folder}/{j} 不是 1_label.py 產生的標定檔（缺 px_per_mm）")
            s_ = float(cfg[s_key])
            if "frame_height" not in cfg:
                _cap = cv2.VideoCapture(os.path.join(common.PROJECT, folder, cfg["video"]))
                cfg["frame_height"] = int(_cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 10 ** 9
                _cap.release()
            yb = 0.5 * (cfg["silo"][1][1] + cfg["silo"][2][1])
            need = min(float(cfg["frame_height"]), yb + (0.5 * meta["alpha"] * meta["b_mm"] + meta["b_mm"]) * s_)
            if cfg["roi"][3] < need - 1.0:
                raise RuntimeError(f"{folder}/{j}：ROI 下緣 y={cfg['roi'][3]} 不夠低（需要 ≥ {need:.0f}），"
                                   "請用 1_label.py 重新產生這支的標定檔")
            vp = os.path.join(common.PROJECT, folder, cfg["video"])
            if not os.path.exists(vp):
                raise RuntimeError(f"找不到影片 {vp}")
            out_dir = os.path.join(OUT_DIR, folder, os.path.splitext(cfg["video"])[0] + "_out")
            if os.path.exists(os.path.join(out_dir, DONE_MARK)):
                done += 1
                first = False                  # 這個資料夾已經有跑完的影片，"first" 模式不再輸出 overlay
                continue
            if os.path.isdir(out_dir):         # 上次跑到一半中斷留下的：不自動刪，請你確認後手動刪
                leftover.append(out_dir)
                continue
            ov = OVERLAY == "all" or (OVERLAY == "first" and first)
            first = False
            # [v3] 這支影片要跑幾幀（算整體進度用）：.json 的範圍和影片實際長度取小的
            _cap = cv2.VideoCapture(vp)
            n_vid = int(_cap.get(cv2.CAP_PROP_FRAME_COUNT))
            _cap.release()
            f_end = min(cfg["end_frame"], n_vid - 1) if n_vid > 0 else cfg["end_frame"]
            if MAX_FRAMES:
                f_end = min(f_end, cfg["start_frame"] + MAX_FRAMES - 1)
            n_frames[f"{folder}/{cfg['video']}"] = max(1, f_end - cfg["start_frame"] + 1)
            # 最後兩個欄位（共用進度表、這支的名稱）在下面開始跑之前才填
            jobs.append((folder, jp, vp, out_dir, ov, WORKERS > 1, None, f"{folder}/{cfg['video']}"))

    print(f"已跑完 {done} 支（跳過）、這次要跑 {len(jobs)} 支、{WORKERS} 個行程")
    if no_labels:
        print(f"沒有標定檔的資料夾（先跑 1_label.py）：{no_labels}")
    if leftover:
        print("下列資料夾是上次沒跑完留下的，這次不會處理。要重跑請先手動把它刪掉：")
        for d in leftover:
            print(f"    {d}")
    if not jobs:
        print("沒有需要分析的影片。")
        return
    manifest = dict(kind="track", created=stamp, code_hash=common.code_hash(), lookup_sha256=lookup_sha,
                    lookup=table, labels_dir=LABELS_DIR, overlay=OVERLAY, workers=WORKERS,
                    below_rule="0.5*a + 1.0*b", videos=[f"{j[0]}/{os.path.basename(j[2])}" for j in jobs],
                    params=dict(CLOG_FRAMES=CLOG_FRAMES, EMPTY_N=EMPTY_N, DROP_FIRST_EVENT=DROP_FIRST_EVENT,
                                MIN_EVENT_DROP=MIN_EVENT_DROP, COUNT_SMOOTH_FRAMES=COUNT_SMOOTH_FRAMES,
                                COUNT_RISE_FRAMES=COUNT_RISE_FRAMES, MIN_TRACK_FRAMES=MIN_TRACK_FRAMES,
                                CHANNEL=CHANNEL, WORK_B_PX=WORK_B_PX, SIZE_AUTO=SIZE_AUTO,
                                MF_MIN_RESPONSE=MF_MIN_RESPONSE, MAX_OVERLAP=MAX_OVERLAP,
                                MIN_COVERAGE=MIN_COVERAGE, SEAM_K=SEAM_K, V_MOVE_B_S=V_MOVE_B_S,
                                MEMORY_FRAMES=MEMORY_FRAMES, ROLL_CORRECT=ROLL_CORRECT,
                                SEARCH_PAD=SEARCH_PAD),
                    versions=dict(python=sys.version.split()[0], cv2=cv2.__version__,
                                  numpy=np.__version__, pandas=pd.__version__))
    with open(os.path.join(LOGS_DIR, f"track_{stamp}.json"), "x", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)

    n_ok, fails = 0, []
    t0 = time.time()

    def report(k, r):
        msg = (f"P_c={r['P_c']:.4f} Q={r['flow']:.1f} 顆/s 事件 {r['n_events']} ({r['seconds']:.0f}s)"
               if r["ok"] else f"失敗 — {r['message']}")
        print(f"[{k}/{len(jobs)}] {r['folder'][-6:]}/{r['video']}: {msg}  （累計 {time.time() - t0:.0f}s）")
        sys.stdout.flush()

    total_frames = sum(n_frames.values())
    print(f"總共 {total_frames:,} 幀（約 {total_frames / 120 / 60:.1f} 分鐘的影片）")

    def show_progress(prog, finished):
        """[v3] 印一次整體進度：完成幾支、全部幀數的百分比、預估剩餘時間，
        再逐支列出正在跑的影片跑到哪裡。
        預估剩餘時間 = 已經花的時間 × (還沒跑的幀數 ÷ 已經跑完的幀數)。"""
        snap = dict(prog)                                    # 先複製一份，避免讀到一半被改
        done_frames = sum(n_frames[k] for k in finished)
        done_frames += sum(v[1] for k, v in snap.items() if k not in finished)
        el = time.time() - t0
        frac = done_frames / total_frames if total_frames else 0
        eta = f"預估還要 {fmt_dur(el * (1 - frac) / frac)}" if frac > 0.01 else "預估時間計算中"
        print(f"[進度 {time.strftime('%H:%M:%S')}] 完成 {len(finished)}/{len(jobs)} 支｜"
              f"全部 {frac:.0%}（{done_frames:,}/{total_frames:,} 幀）｜"
              f"已經跑了 {fmt_dur(el)}｜{eta}")
        for key, (stage, d, tot, _) in sorted(snap.items()):
            if key in finished:
                continue
            print(f"    {key[-30:]:<30} {stage:<6} {d / tot:4.0%}（{d:,}/{tot:,} 幀）")
        sys.stdout.flush()

    if WORKERS > 1:
        # [v3] 原本用 imap_unordered，主程式只能等下一支影片跑完；
        #      改成 apply_async，主程式每 0.5 s 檢查一次，順便定時印出進度。
        mgr = mp.Manager()
        prog = mgr.dict()                                    # 各行程共用的進度表：名稱 → (階段, 已完成幀數, 總幀數, 時間)
        jobs = [j[:6] + (prog, j[7]) for j in jobs]
        finished = set()
        with mp.Pool(WORKERS) as pool:
            pending = {pool.apply_async(_run_job, (j,)): j for j in jobs}
            last = time.time()
            k = 0
            while pending:
                for ar in [a for a in pending if a.ready()]:
                    j = pending.pop(ar)
                    finished.add(j[7])
                    k += 1
                    try:
                        r = ar.get()
                    except Exception as e:             # [2.2] 行程本身出事（例如被強制結束）也只算這一支失敗
                        r = dict(ok=False, folder=j[0], video=os.path.basename(j[2]),
                                 error_type=type(e).__name__, message=str(e), traceback="", seconds=0.0)
                    n_ok += r["ok"]
                    if not r["ok"]:
                        fails.append(r)
                    report(k, r)
                if time.time() - last >= PROGRESS_EVERY_S and pending:
                    show_progress(prog, finished)
                    last = time.time()
                time.sleep(0.5)
        mgr.shutdown()
    else:
        for k, job in enumerate(jobs, 1):
            r = _run_job(job)
            n_ok += r["ok"]
            if not r["ok"]:
                fails.append(r)
            report(k, r)

    if fails:
        pd.DataFrame([{k: v for k, v in r.items() if k != "ok"} for r in fails]).to_csv(
            os.path.join(LOGS_DIR, f"track_failures_{stamp}.csv"), index=False, encoding="utf-8-sig")
        print(f"\n失敗的影片與原因：logs/track_failures_{stamp}.csv"
              "\n（失敗的影片會留下不完整的 _out 資料夾，修正後要重跑請先手動刪掉它）")
    print(f"\n成功 {n_ok}、失敗 {len(fails)}，耗時 {time.time() - t0:.0f} s\n結果在 {OUT_DIR}\n下一步：執行 3_plot.py")


if __name__ == "__main__":
    main()
