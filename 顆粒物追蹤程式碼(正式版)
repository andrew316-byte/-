def plot_count_trace(fr, ev, fps, path, title):
    """畫出筒倉內顆粒數 N(t) 與狀態，用來一眼檢查堵塞切分有沒有對。
      灰色細線  每幀的原始 N（計入筒倉內的顆數）
      黑色粗線  平滑後的 N（流動判定用的就是這條）
      底色      橘 = 流動、綠 = 堵塞、灰 = 流光
      每段流動上方的數字是該事件的掉落數 s（括號內是分類的縮寫）"""
    import matplotlib
    matplotlib.use("Agg")                     # 不開視窗，直接存檔
    import matplotlib.pyplot as plt
    # 中文字型：依序試微軟正黑體（Windows）、Noto（Linux），都沒有就用預設字型
    plt.rcParams["font.sans-serif"] = ["Microsoft JhengHei", "Noto Sans CJK TC",
                                       "Noto Sans CJK JP", "DejaVu Sans"]
    plt.rcParams["axes.unicode_minus"] = False
    t = fr["t_sec"].to_numpy()
    fig, ax = plt.subplots(figsize=(14, 4.5))
    colors = {"flow": "#f5b26b", "clog": "#9fd8a4", "empty": "#cccccc"}
    st = fr["state"].to_numpy()
    s0 = 0
    for i in range(1, len(st) + 1):           # 逐段塗底色
        if i == len(st) or st[i] != st[s0]:
            ax.axvspan(t[s0], t[i - 1] + 1.0 / fps, color=colors.get(st[s0], "white"),
                       alpha=0.5, lw=0)
            s0 = i
    ax.plot(t, fr["n_in_silo"], color="0.6", lw=0.6, label="N 原始")
    ax.plot(t, fr["n_in_silo_smooth"], color="k", lw=1.4, label="N 平滑後")
    short = {"normal": "n", "first": "f", "last_censored": "c", "excluded": "x"}
    ytop = float(fr["n_in_silo"].max())
    for _, e in ev.iterrows():
        tm = ((e.start_frame + e.end_frame) / 2 - fr["frame"].iloc[0]) / fps
        ax.text(tm, ytop + 1, f"{e.s_count:.0f}({short.get(e.event_type, '?')})",
                ha="center", va="bottom", fontsize=8)
    ax.set_xlabel("t (s)")
    ax.set_ylabel("筒倉內顆粒數 N")
    ax.set_title(title + "   底色：橘=流動  綠=堵塞  灰=流光；數字 = 掉落數 s"
                 "（n=normal f=first c=刪失 x=不納入）", fontsize=9)
    ax.set_ylim(top=ytop + 6)
    ax.legend(loc="lower left", fontsize=8)
    fig.tight_layout()
    fig.savefig(path, dpi=110)
    plt.close(fig)


