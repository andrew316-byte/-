_HERE = os.path.dirname(os.path.abspath(__file__))
LABELS_DIR = os.path.join(_HERE, "labels")        # 1_label.py 產生的標定檔
OUT_DIR = os.path.join(_HERE, "analysis_count")   # [v3] 結果放這裡（新資料夾，舊的 analysis/ 不動）
