def write_overlay(video, path, df, fr, ev, silo, roi, ra, rb, f0, f1, fps, alpha, v_move):
    """追蹤過程影片。畫面上的東西：
      綠線      筒倉壁與出口線（出口線 y = 0）
      黃橢圓    [v3] 計入「筒倉內」的顆粒（最高點在出口線以上、軌跡夠長），中心小點是質心
      洋紅橢圓  [v3] 不計入的顆粒：整顆都已經在出口線下方
      橘色尾巴  正在移動的顆粒最近 OVERLAY_TRAIL 幀走過的路徑，用來看追蹤有沒有斷
      上方兩行文字
        第一行：幀號、時間、狀態、這一幀偵測到幾顆、筒倉內幾顆（原始 / 平滑後）、
                累計離開幾顆
        第二行：目前在第幾個事件；上一次掉落事件的顆粒數 s 與它的分類
    """
    x0, y0, x1, y1 = roi
    k = min(1.0, 1000.0 / (y1 - y0))
    size = (int((x1 - x0) * k), int((y1 - y0) * k))
    # 寫檔的幀率要取整數：mp4v 的時間基底分母上限是 65535，直接丟 119.917
    # 這種小數進去會算出 1000/119917 而開不了編碼器。這只影響播放速度標示，
    # 不影響任何分析數值（分析一律用 .json 裡的 true_fps）。
    vw = cv2.VideoWriter(path, cv2.VideoWriter_fourcc(*"mp4v"), round(fps), size)
    if not vw.isOpened():
        print("    ⚠ 開不了影片編碼器，略過 overlay.mp4")
        return
    # 被軌跡壽命門檻濾掉的顆粒不畫出來，畫面上看到的黃色就是真正被計入的。
    # 整顆已經在出口線下方的顆粒不套用這個過濾（它們本來就不計入，畫成洋紅色
    # 方便確認「部分在筒倉內」的判定有沒有對）。
    show = df[df["long_track"] | (~df["in_silo_raw"])]
    by_f = {f: g for f, g in show.groupby("frame")}
    st = fr.set_index("frame")

    # 「上一次掉落的顆粒數」：對每一幀查出最後一個已經結束的事件，
    # 把它的 s_count 和分類先算好，播放時直接查表。
    prev_txt = {}
    done = []
    for fi in range(f0, f1 + 1):
        while len(done) < len(ev) and int(ev["end_frame"].iloc[len(done)]) < fi:
            done.append(len(done))
        if done:
            e = ev.iloc[done[-1]]
            prev_txt[fi] = (f"last drop: s={e.s_count:.0f}  [{e.event_type}]  "
                            f"event {int(e.event_id)}")
        else:
            prev_txt[fi] = "last drop: --"

    cap = cv2.VideoCapture(video)
    cap.set(cv2.CAP_PROP_POS_FRAMES, f0)
    S = 16                                              # cv2 次像素繪圖：座標 ×16
    trail = {}                                          # id → 最近幾幀的質心座標

    def P(x, y):
        return (int(round((x - x0) * k * S)), int(round((y - y0) * k * S)))

    def Q(x, y):                                        # 整數像素座標（畫文字、點用）
        return (int(round((x - x0) * k)), int(round((y - y0) * k)))

    for fi in range(f0, f1 + 1):
        ok, frame = cap.read()
        if not ok:
            break
        cam = ((st.loc[fi, "cam_dx_px"], st.loc[fi, "cam_dy_px"])
               if fi in st.index else (0.0, 0.0))
        img = cv2.resize(crop_stable(frame, (x0, y0, x1, y1), np.array(cam, float)), size)
        for a, b in ((silo.LT, silo.LB), (silo.LB, silo.RB), (silo.RB, silo.RT)):
            cv2.line(img, P(*a), P(*b), (0, 255, 0), 1, cv2.LINE_AA, 4)

        g = by_f.get(fi)
        alive = set()
        if g is not None:
            for r in g.itertuples():
                alive.add(r.id)
                col_p = (0, 220, 220) if r.in_silo else (255, 0, 255)   # 黃 = 計入、洋紅 = 不計入
                th = 0.0 if alpha < 1.05 else r.theta_img
                # 輪廓
                cv2.ellipse(img, P(r.x_px, r.y_px), (int(ra * k * S), int(rb * k * S)),
                            th, 0, 360, col_p, 1, cv2.LINE_AA, 4)
                # 質心
                cv2.circle(img, P(r.x_px, r.y_px), int(1.5 * S), (255, 255, 255),
                           -1, cv2.LINE_AA, 4)
                # 軌跡尾巴：只有在動的才畫，不然靜止的料堆會糊成一片
                if OVERLAY_TRAIL > 0:
                    h = trail.setdefault(r.id, [])
                    h.append((r.x_px, r.y_px))
                    del h[:-OVERLAY_TRAIL]
                    if r.v_down_mm_s > v_move and len(h) > 1:
                        cv2.polylines(img, [np.array([Q(*p) for p in h], np.int32)],
                                      False, (0, 140, 255), 1, cv2.LINE_AA)
                if OVERLAY_SHOW_IDS:
                    px, py = Q(r.x_px, r.y_px)
                    cv2.putText(img, str(int(r.id)), (px - 8, py - 4), 0, 0.32,
                                (255, 255, 255), 1, cv2.LINE_AA)
        for i in list(trail):                            # 消失的軌跡不要一直留著
            if i not in alive:
                del trail[i]

        if fi in st.index:
            s_ = st.loc[fi]
            col = {"flow": (0, 200, 255), "clog": (200, 255, 200),
                   "empty": (160, 160, 160)}[s_.state]
            # tracked 是畫面上實際畫出來的顆粒數（已扣掉被壽命門檻濾掉的）
            l1 = (f"f{fi}  t={(fi - f0) / fps:6.2f}s  {s_.state.upper():5}  "
                  f"tracked={int(s_.n_detected) - int(s_.n_short_track)}  "
                  f"in_silo={int(s_.n_in_silo)}/{int(s_.n_in_silo_smooth)}  "
                  f"left_cum={int(s_.n_drop_cum)}")
            e_now = int(s_.event_id)
            l2 = (f"event={'-' if e_now < 0 else e_now}   {prev_txt[fi]}")
            cv2.rectangle(img, (0, 0), (size[0], 40), (0, 0, 0), -1)
            cv2.putText(img, l1, (5, 15), 0, 0.46, col, 1, cv2.LINE_AA)
            cv2.putText(img, l2, (5, 33), 0, 0.46, (255, 255, 255), 1, cv2.LINE_AA)
        vw.write(img)
    cap.release()
    vw.release()


