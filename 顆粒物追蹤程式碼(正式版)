def read_frame(cap, i):
    """跳到第 i 幀並讀出來（BGR）。"""
    cap.set(cv2.CAP_PROP_POS_FRAMES, int(i))
    ok, f = cap.read()
    return f if ok else None


def crop_stable(frame, roi, cam):
    """一次做完「抵銷相機晃動」和「裁出 ROI」。
    相機被碰到時整幀會平移 cam（px），這裡用一個仿射矩陣同時平移 −cam 並把
    原點移到 ROI 左上角，輸出大小就是 ROI。比先 warp 整幀再裁快一倍以上，
    而且支援次像素位移（直接 warp 整幀只是為了同一件事多算了 ROI 以外的像素）。"""
    x0, y0, x1, y1 = roi
    if np.hypot(*cam) < 0.3:
        return frame[y0:y1, x0:x1]
    M = np.float32([[1, 0, -x0 - cam[0]], [0, 1, -y0 - cam[1]]])
    return cv2.warpAffine(frame, M, (x1 - x0, y1 - y0), borderMode=cv2.BORDER_REPLICATE)


def angdiff180(a, b):
    """兩個「180° 週期」角度的差，範圍 [-90, 90)。橢圓轉 180° 和原來一樣。"""
    return (np.asarray(a) - np.asarray(b) + 90.0) % 180.0 - 90.0


def parabolic(fm, f0, fp):
    """三點拋物線內插，回傳峰值相對中間點的偏移（-0.5 ~ 0.5），用來做次像素定位。"""
    den = fm - 2.0 * f0 + fp
    return 0.0 if den >= -1e-12 else float(np.clip(0.5 * (fm - fp) / den, -0.5, 0.5))


def half_extent(ra, rb, th_deg, nx, ny):
    """橢圓的支撐函數：橢圓投影到方向 (nx, ny) 上的半寬。
    h(n) = sqrt((ra·cosψ)² + (rb·sinψ)²)，ψ = 方向 n 與長軸的夾角。
    這裡用來算「顆粒在鉛直方向上伸出質心多遠」，判斷整顆是否已經在出口線下方。"""
    psi = np.arctan2(ny, nx) - np.radians(th_deg)
    return np.hypot(ra * np.cos(psi), rb * np.sin(psi))


def runs(mask):
    """布林序列 → [(開始索引, 結束索引(含), 值)]。用來找連續的堵塞段／流動段。"""
    out, s = [], 0
    for i in range(1, len(mask) + 1):
        if i == len(mask) or mask[i] != mask[s]:
            out.append((s, i - 1, bool(mask[s])))
            s = i
    return out


def fmt_dur(sec):
    """[v3] 秒數 → 好讀的時間字串，例如 45s、12m30s、1h05m。"""
    sec = max(0, int(round(sec)))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m{sec % 60:02d}s"
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m"


def count_drops(N_s, rise_frames):
    """[v3] 平滑後的筒倉內顆粒數 N_s → 每一幀「離開了幾顆」。
    用一個「平台值」L 代表目前認定的筒倉內顆粒數，逐幀更新：
      N_s < L：有顆粒離開 → 這一幀記 L − N_s 顆，L 降到 N_s。
      N_s > L：顆粒不可能自己回到筒倉，所以這是偵測造成的（之前漏抓、現在又抓回來）。
               連續 rise_frames 幀都比 L 多，才把 L 往上調到這段期間的最小值，
               而且不記任何事件。不往上調的話，下一次真正的掉落會被吃掉。
      N_s = L：沒事。
    回傳 (每幀的平台值 L, 每幀離開的顆數)，兩者長度都和 N_s 一樣。"""
    n = len(N_s)
    L = np.zeros(n)                    # 每一幀的平台值
    drop = np.zeros(n, int)            # 每一幀離開的顆數
    lev = float(N_s[0]) if n else 0.0  # 目前的平台值
    above = 0                          # N_s 已經連續幾幀比平台值多
    for t in range(n):
        x = float(N_s[t])
        if x < lev:
            drop[t] = int(round(lev - x))
            lev, above = x, 0
        elif x > lev:
            above += 1
            if above >= rise_frames:
                lev, above = float(np.min(N_s[t - rise_frames + 1:t + 1])), 0
        else:
            above = 0
        L[t] = lev
    return L, drop


