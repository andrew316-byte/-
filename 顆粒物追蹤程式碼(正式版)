# [B] 顆粒偵測
# ==========================================================================
class Detector:
    """在「工作尺度」影像上偵測顆粒。工作尺度 = 把短軸縮到約 WORK_B_PX px，
    這樣圓盤和細長橢圓都用同一套程式碼、同樣的相對解析度。"""

    def __init__(self, ra_w, rb_w, mask_w, channel, alpha):
        self.mask = mask_w
        self.channel = channel
        self.alpha = alpha
        self.thr_hist = []
        self.t_floor = 0.0        # 閾值下限，由 set_floor() 設定
        self.delta_floor = 0.0
        self.set_size(ra_w, rb_w)

    def set_floor(self, samples_w):
        """用「顆粒最多的那幾幀」訂一個閾值下限。
        為什麼需要：顆粒全部流光之後畫面只剩黑背景，這時候 Otsu 會把背景的
        雜訊硬切成兩類，閾值掉到很低，倒影和雜訊就會被當成前景，程式會在
        空筒倉裡「偵測」出幾十顆不存在的顆粒。照明固定時顆粒的亮度是穩定的，
        所以把閾值壓在「背景 + 0.35×(顆粒−背景)」之上，空畫面就不會有前景。"""
        ts, deltas = [], []
        for f in samples_w:
            ch = cv2.GaussianBlur(get_channel(f, self.channel), (3, 3), 0)
            vals = ch[self.mask > 0]
            t, _ = cv2.threshold(vals.reshape(-1, 1), 0, 255,
                                 cv2.THRESH_BINARY + cv2.THRESH_OTSU)
            hi, lo = vals[vals > t], vals[vals <= t]
            if len(hi) < 50 or len(lo) < 50:
                continue
            ts.append((float(lo.mean()), float(hi.mean())))
            deltas.append(float(hi.mean() - lo.mean()))
        if not ts:
            return 0.0, 0.0
        lo_ref = float(np.median([a for a, _ in ts]))
        hi_ref = float(np.median([b for _, b in ts]))
        self.t_floor = lo_ref + 0.35 * (hi_ref - lo_ref)
        self.delta_floor = 0.5 * float(np.median(deltas))
        return self.t_floor, hi_ref - lo_ref

    def set_size(self, ra, rb):
        """建立模板庫：內圈橢圓權重總和 +1、外環總和 −1（零均值）。
        響應 = 內圈前景比例 − 外環前景比例：孤立顆粒 ≈1，兩顆中間的縫 ≈0。
        α > 1 時每隔 step 度建一個朝向；step 隨 α 變細（長軸越長，角度越敏感）。"""
        self.ra, self.rb = ra, rb
        r = int(np.ceil(1.5 * rb))
        self.kmin = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * r + 1, 2 * r + 1))
        r = max(1, int(round(0.5 * rb)))
        self.kseam = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * r + 1, 2 * r + 1))
        self.disc = self.alpha < 1.05
        self.step = 180.0 if self.disc else min(30.0, 45.0 / self.alpha)
        self.angles = np.arange(0.0, 180.0, self.step)
        beta = 1.0 + 2.5 / rb                     # 外環厚度約 2.5 px（看得到縫）
        R = int(np.ceil(beta * ra)) + 1
        yy, xx = np.mgrid[-R:R + 1, -R:R + 1].astype(np.float32)
        self.R, self.K, self.inside = R, [], []
        # 穿縫檢查的取樣點（以長軸為 u 軸）：長軸本身 + 兩條 ±0.35 短半軸的平行線，
        # 長度縮在橢圓內 65% 處，避免取到顆粒邊緣（燒焦邊緣會讓表觀邊界內縮）
        uv, line = [], []
        for li, v0 in enumerate((0.0, 0.35, -0.35)):
            L = 0.65 * ra * np.sqrt(1 - v0 ** 2)
            u = np.arange(-L, L + 0.5, 1.0)
            uv.append(np.stack([u, np.full_like(u, v0 * rb)]))
            line.append(np.full(len(u), li))
        self.axis_uv, self.axis_line = np.concatenate(uv, axis=1), np.concatenate(line)
        for th in self.angles:
            t = np.radians(th)
            u = xx * np.cos(t) + yy * np.sin(t)       # 沿長軸
            v = -xx * np.sin(t) + yy * np.cos(t)      # 沿短軸
            ins = (u / ra) ** 2 + (v / rb) ** 2 <= 1
            ring = ((u / (beta * ra)) ** 2 + (v / (beta * rb)) ** 2 <= 1) & ~ins
            K = np.zeros_like(xx)
            K[ins], K[ring] = 1.0 / ins.sum(), -1.0 / ring.sum()
            self.K.append(K)
            self.inside.append(ins)

    def binarize(self, img_w, smooth=True):
        """二值化 = 全域 Otsu 與「局部閾值」取較嚴的那個。
        全域 Otsu 只用筒倉內像素算（9 幀中位數平滑），但它會被大片黑背景拉低；
        當顆粒間的縫被倒影照亮時，縫也會超過 Otsu，相鄰顆粒就黏成一片。
        局部閾值：每個顆粒像素離縫都不超過一個短半軸，所以 1.5 個短半軸內的
        局部最小值 =「這附近的縫有多亮」。像素要比它亮 0.35×(前景−背景) 才算前景。"""
        ch = cv2.GaussianBlur(get_channel(img_w, self.channel), (3, 3), 0)
        vals = ch[self.mask > 0]
        t, _ = cv2.threshold(vals.reshape(-1, 1), 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        hi, lo = vals[vals > t], vals[vals <= t]
        delta = float(hi.mean() - lo.mean()) if len(hi) and len(lo) else 0.0
        if smooth:
            self.thr_hist = (self.thr_hist + [(t, delta)])[-9:]
            t, delta = np.median(np.array(self.thr_hist), axis=0)
        t = max(float(t), self.t_floor)          # 空畫面時 Otsu 會失控，壓住下限
        delta = max(float(delta), self.delta_floor)
        local = cv2.erode(ch, self.kmin).astype(np.float32) + 0.35 * delta
        # 黑帽運算 = 閉運算 − 原圖，專抓「比短半軸窄的暗谷」= 緊貼的顆粒間的縫。
        # 挖掉縫的前景只拿來算匹配濾波響應（讓峰值落在正確的顆粒上）；
        # 覆蓋率檢查仍用原前景，否則顆粒表面的燒痕紋路會被當成縫而誤殺。
        seam = cv2.morphologyEx(ch, cv2.MORPH_BLACKHAT, self.kseam) > SEAM_K * delta
        fg = ((ch > np.maximum(t, local)) & (self.mask > 0)).astype(np.uint8)
        fg = cv2.morphologyEx(fg, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))
        self.fg_seam = fg & ~seam
        return fg, float(t)

    def response(self, fg):
        """每個朝向做一次相關，回傳 (各朝向響應堆疊, 最大響應, 最佳朝向索引)。"""
        f = fg.astype(np.float32)
        stack = np.stack([cv2.filter2D(f, cv2.CV_32F, K, borderType=cv2.BORDER_CONSTANT)
                          for K in self.K])
        return stack, stack.max(0), stack.argmax(0)

    def detect(self, img_w):
        """回傳 det = [(x, y, θ_影像, 響應), ...]（工作尺度座標）。"""
        fg, thr = self.binarize(img_w)
        stack, rmax, amax = self.response(self.fg_seam)
        H, W = fg.shape
        # 候選峰：局部極大 + 響應下限。最小間距只取 0.5 短半軸，因為細長顆粒
        # 並排時中心距離只有一個短軸，不能用等效直徑當最小間距。
        md = max(1, int(0.5 * self.rb))
        pk = (rmax == maximum_filter(rmax, size=2 * md + 1)) & (rmax > MF_MIN_RESPONSE)
        ys, xs = np.nonzero(pk)
        order = np.argsort(-rmax[ys, xs])
        occ = np.zeros((H, W), np.uint8)            # 已接受顆粒蓋掉的範圍
        R, out = self.R, []
        for y, x in zip(ys[order], xs[order]):
            k = amax[y, x]
            ins = self.inside[k]
            ya, yb, xa, xb = max(0, y - R), min(H, y + R + 1), max(0, x - R), min(W, x + R + 1)
            m = ins[ya - y + R:yb - y + R, xa - x + R:xb - x + R]
            vis = m & (self.mask[ya:yb, xa:xb] > 0)
            if vis.sum() < 0.4 * ins.sum():                       # 大半在 ROI／筒倉外
                continue
            if (occ[ya:yb, xa:xb][m] > 0).mean() > MAX_OVERLAP:   # 和已接受的重疊太多
                continue
            if fg[ya:yb, xa:xb][vis].mean() < MIN_COVERAGE:       # 橢圓內前景不夠
                continue
            dx = parabolic(rmax[y, x - 1], rmax[y, x], rmax[y, x + 1]) if 0 < x < W - 1 else 0
            dy = parabolic(rmax[y - 1, x], rmax[y, x], rmax[y + 1, x]) if 0 < y < H - 1 else 0
            th = 0.0
            if not self.disc:
                n = len(self.angles)
                th = (self.angles[k] + self.step * parabolic(
                    stack[(k - 1) % n, y, x], stack[k, y, x], stack[(k + 1) % n, y, x])) % 180
            # 穿縫檢查：斜跨兩顆的假橢圓會被「橫貫的暗縫」同時切過三條取樣線；
            # 顆粒表面的燒痕暗點只是局部，最多碰到一條。
            c, sn = np.cos(np.radians(th)), np.sin(np.radians(th))
            u, v = self.axis_uv
            ax = np.rint(x + dx + u * c - v * sn).astype(int)
            ay = np.rint(y + dy + u * sn + v * c).astype(int)
            ok = (ax >= 0) & (ax < W) & (ay >= 0) & (ay < H)
            ok[ok] = self.mask[ay[ok], ax[ok]] > 0
            hit = np.zeros(3, bool)
            hit[np.unique(self.axis_line[ok][fg[ay[ok], ax[ok]] == 0])] = True
            if hit.all():
                continue
            occ[ya:yb, xa:xb][m] = 1
            out.append((x + dx, y + dy, th, float(rmax[y, x])))
        return np.array(out, float).reshape(-1, 4), thr


def measure_size(det_obj, samples_w, ra0, rb0):
    """表觀大小自動量測：模板縮放 k = 0.80~1.10，看哪個 k 讓峰值響應最高。
    燒焦的深色邊緣會讓顆粒在二值圖上看起來比實際小一點，
    判斷「整顆是否在出口線下方」要用畫面上看起來的大小才一致。"""
    ks, sc = np.arange(0.80, 1.101, 0.05), []
    fgs = [det_obj.binarize(f, smooth=False)[0] for f in samples_w]
    for k in ks:
        det_obj.set_size(ra0 * k, rb0 * k)
        vals = []
        for fg in fgs:
            _, rmax, _ = det_obj.response(fg)
            md = max(1, int(0.5 * det_obj.rb))
            pk = (rmax == maximum_filter(rmax, size=2 * md + 1)) & (rmax > 0.3)
            v = np.sort(rmax[pk])[::-1]
            vals += list(v[:max(1, len(v) // 2)])    # 只取前一半（偵測得最清楚的）
        sc.append(np.median(vals) if vals else 0)
    i = int(np.argmax(sc))
    k = ks[i] + (0.05 * parabolic(sc[i - 1], sc[i], sc[i + 1]) if 0 < i < len(ks) - 1 else 0)
    det_obj.set_size(ra0 * k, rb0 * k)
    return float(k)


# ==========================================================================
# [C] 追蹤
# ==========================================================================
class Tracker:
    """等速度預測 + 匈牙利演算法做全域最佳指派。
    b_px = 顆粒短軸長度（px），用來訂配對的距離門檻。"""

    def __init__(self, b_px, alpha):
        self.b = b_px
        self.alpha = alpha
        self.T = {}          # id → [x, y, vx, vy, θ(連續), 幾幀沒看到]
        self.next = 0

    def step(self, det):
        ids = list(self.T)
        out = np.full(len(det), -1, int)
        if ids and len(det):
            tr = np.array([self.T[i] for i in ids])
            dt = tr[:, 5] + 1
            pred = tr[:, :2] + tr[:, 2:4] * dt[:, None]       # 等速度外推
            D = np.hypot(pred[:, None, 0] - det[None, :, 0],
                         pred[:, None, 1] - det[None, :, 1])
            # 門檻：一個短軸 + 半個預測位移。出口附近顆粒一幀可以掉 20–40 px，
            # 門檻太小會在最關鍵的地方斷軌，所以基底用整個短軸而不是半個。
            gate = 1.0 * self.b + 0.5 * np.hypot(tr[:, 2], tr[:, 3]) * dt
            bad = D > gate[:, None]
            if self.alpha >= 1.3:    # 一幀之內不可能轉超過 30°
                bad |= np.abs(angdiff180(tr[:, None, 4], det[None, :, 2])) > 30
            C = np.where(bad, 1e9, D)
            for r, c in zip(*linear_sum_assignment(C)):
                if C[r, c] >= 1e9:
                    continue
                t = self.T[ids[r]]
                v = (det[c, :2] - np.array(t[:2])) / (t[5] + 1)
                t[2:4] = list(0.3 * np.array(t[2:4]) + 0.7 * v)   # 速度做一點平滑
                t[0], t[1] = det[c, 0], det[c, 1]
                t[4] = t[4] + angdiff180(det[c, 2], t[4])         # 角度 unwrap
                t[5] = -1
                out[c] = ids[r]
        for i in ids:
            self.T[i][5] += 1
            if self.T[i][5] > MEMORY_FRAMES:
                del self.T[i]
        for c in np.nonzero(out < 0)[0]:
            self.T[self.next] = [det[c, 0], det[c, 1], 0.0, 0.0, det[c, 2], 0]
            out[c] = self.next
            self.next += 1
        return out


# ==========================================================================
# 單支影片的完整分析
# ==========================================================================
def analyze_one(video_path, cfg, log, out_dir, do_overlay=False, legacy_scale=False,
                progress=None):
    """progress：[v3] 回報進度用的函式 progress(階段, 已完成幀數, 總幀數)，
    平行跑的時候由主程式傳進來，不需要的話留 None。"""
    def report(stage, done, total):
        if progress is not None:
            progress(stage, done, total)

    # [v2] out_dir 由呼叫端指定（在 run 資料夾內）；已存在就失敗，不覆寫
    os.makedirs(out_dir, exist_ok=False)

    # ---------------- [A] 標定讀取 ----------------
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        raise RuntimeError("打不開影片")
    f0, f1 = cfg["start_frame"], cfg["end_frame"]
    if MAX_FRAMES:
        f1 = min(f1, f0 + MAX_FRAMES - 1)
    # [v3] 進度條用的總幀數：.json 的 end_frame 可能比影片實際長度還多（剪過的片段），
    #      所以和影片的幀數取小的。這個數字只拿來算進度百分比，不影響分析範圍。
    n_vid = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    n_est = max(1, (min(f1, n_vid - 1) if n_vid > 0 else f1) - f0 + 1)
    report("準備中", 0, n_est)
    fps = float(cfg["true_fps"])
    alpha = float(cfg["alpha"])
    d_eq = float(cfg["d_eq_mm"])
    n_init = int(cfg["n_initial"])
    n_use = f1 - f0 + 1
    ref = read_frame(cap, f0)
    log(f"影片 {cfg['video']}：{ref.shape[1]}×{ref.shape[0]}，分析第 {f0}–{f1} 幀"
        f"（{n_use} 幀 @ {fps:.1f} fps = {n_use / fps:.1f} s）")
    log(f"    α = {alpha}、d_eq = {d_eq} mm、初始顆粒數 = {n_init}")

    s_tpl, sinfo = screw_scale(cap, f0, f1, np.array(cfg["screws"], float), cfg["screw_distance_mm"])
    # [v2] 比例尺來源。screw_scale 的模板以「四捨五入後的座標」為中心，兩心間距因此被量化到
    #      整數像素；它只適合當相機晃動的追蹤器。次像素比例尺由自動標記寫在 .json 的 px_per_mm。
    if legacy_scale:
        s = s_tpl
        log(f"[A] 比例尺 {s:.4f} px/mm（--legacy-scale：原檔的模板間距算法；螺絲間距 "
            f"{sinfo['dist_px']:.2f} px，{sinfo['n']} 幀標準差 {sinfo['sd_px']:.2f} px，"
            f"互相關 {sinfo['corr']:.2f}）")
    else:
        # [v3] 新版 1_label.py 只寫 px_per_mm_preview，沒有 px_per_mm → 兩個都接受
        s_key = "px_per_mm" if "px_per_mm" in cfg else "px_per_mm_preview"
        if s_key not in cfg:
            raise RuntimeError(".json 裡沒有 px_per_mm / px_per_mm_preview（不是自動標記產生的標定檔）")
        s = float(cfg[s_key])
        log(f"[A] 比例尺 {s:.4f} px/mm（.json 的次像素螺絲間距）；模板追蹤間距換算 "
            f"{s_tpl:.4f} px/mm（差 {s_tpl / s - 1:+.2%}，{sinfo['n']} 幀標準差 "
            f"{sinfo['sd_px']:.2f} px，互相關 {sinfo['corr']:.2f}）")
    silo = Silo(cfg["silo"], s)
    x0, y0, x1, y1 = cfg["roi"]
    log(f"    出口寬 {silo.D_mm:.1f} mm；相機傾斜 {silo.roll:+.2f}°；"
        f"兩壁半角 {silo.half_angles[0]:.1f}° / {silo.half_angles[1]:.1f}°（設計 30°）")
    log(f"    ROI x {x0}–{x1}、y {y0}–{y1}")

    b_mm, a_mm = d_eq / np.sqrt(alpha), d_eq * np.sqrt(alpha)
    ra0, rb0 = a_mm / 2 * s, b_mm / 2 * s                  # 設計半軸（全圖 px）
    sc = min(1.0, WORK_B_PX / (2 * rb0))                   # 工作尺度縮放倍率
    Ww, Hw = int(round((x1 - x0) * sc)), int(round((y1 - y0) * sc))
    # 遮罩的邊界寬容量也改以短軸全長 b 為特徵長度（原本是等效直徑 d_eq）。
    # ⚠ below_px 是「出口線以下還保留多少範圍」，而流出判定要求整顆都在出口線下方
    #   （最高點 y_top < 0），顆粒質心最多要再往下走一個長半軸 ra = a/2。
    #   1.5·b 在 α 大時會小於 ra（α=3.5：1.5·b = 8.0 mm、ra = 9.35 mm），
    #   長軸接近鉛直的顆粒可能在離開遮罩前都還沒被判定為流出。
    #   若 summary 的流出數明顯偏低，把 1.5 調大（或改用 a_mm）即可。
    # [v2] 出口線以下保留的範圍。原檔固定 1.5·b，並在上面的註解警告：α 大時 1.5·b 會小於
    #      長半軸 ra，長軸接近鉛直的顆粒在離開遮罩前都不會被判定為流出，「若流出數明顯偏低，
    #      把 1.5 調大（或改用 a_mm）」。α = 3 實測穿線計數只有存量法的 18%，小雪崩因為
    #      「流出不到 2 顆」被當成雜訊抹掉、相鄰事件被併在一起。
    #      改成 ra + 1.0·b（= 長半軸再多留一個短軸）。α = 1 時 ra = 0.5·b，剛好等於原本的 1.5·b，
    #      所以圓盤的結果不受影響；所有 α 用同一條公式。--below-orig 可回到原本的 1.5·b。
    below_mm = 1.5 * b_mm if BELOW_ORIG else 0.5 * a_mm + 1.0 * b_mm
    log(f"    出口線以下保留 {below_mm:.2f} mm（{'原檔 1.5·b' if BELOW_ORIG else 'ra + b'}）")
    mask_full = silo.mask(x0, y0, x1, y1, margin_px=0.2 * b_mm * s, below_px=below_mm * s)
    mask_w = cv2.resize(mask_full, (Ww, Hw), interpolation=cv2.INTER_NEAREST)

    def to_work(crop):
        """已經裁好的 ROI 影像 → 工作尺度影像。"""
        return cv2.resize(crop, (Ww, Hw), interpolation=cv2.INTER_AREA)

    roi_box = (x0, y0, x1, y1)
    samples = [to_work(f[y0:y1, x0:x1]) for f in (read_frame(cap, i) for i in
               np.linspace(f0, f1, 40).astype(int)) if f is not None]
    def _to_phys(D):
        """工作尺度的偵測座標 → 物理 mm（通道挑選時判斷是否在筒倉內要用）。"""
        return silo.to_phys(x0 + (D[:, 0] + 0.5) / sc - 0.5,
                            y0 + (D[:, 1] + 0.5) / sc - 0.5)

    if CHANNEL == "auto":
        sub = samples[::max(1, len(samples) // 12)]       # 抽 12 幀就夠，省時間
        channel, st = choose_channel(
            sub, mask_w, lambda c: Detector(ra0 * sc, rb0 * sc, mask_w, c, alpha),
            # 連通判定距離，換算成工作尺度 px。特徵長度改為短軸全長 b。
            # ⚠ 兩顆長軸對接的橢圓，質心距離可達長軸 a = α·b，遠大於 1.45·b，
            #   會被判定為「沒連到主料堆」而把離群率灌水。CHANNEL 固定 "r" 時
            #   不會走到這裡；若改回 "auto" 請把 1.45 放大或改用 a_mm。
            _to_phys, 1.45 * b_mm * s * sc)
        log("    通道自動選擇：" + channel)
        for c, (n_, off, eta) in st.items():
            log(f"      {c:<6} 偵測中位 {n_:5.0f}   離群率 {off:6.2%}   可分離度 {eta:.3f}"
                + ("   <-- 採用" if c == channel else ""))
    else:
        channel = CHANNEL
    detector = Detector(ra0 * sc, rb0 * sc, mask_w, channel, alpha)
    fill = [d_[0].sum() for d_ in (detector.binarize(f, smooth=False) for f in samples)]
    full_idx = np.argsort(fill)[-8:]                     # 顆粒最多的 8 幀
    t_floor, contrast = detector.set_floor([samples[i] for i in full_idx])
    log(f"    閾值下限 {t_floor:.1f}（顆粒與背景亮度差 {contrast:.1f}）")
    k_size = 1.0
    if SIZE_AUTO:
        k_size = measure_size(detector, [samples[i] for i in full_idx], ra0 * sc, rb0 * sc)
        log(f"    表觀大小 = 設計值 × {k_size:.3f}" +
            ("   ⚠ 偏離超過 8%：請檢查螺絲是否點準、d_eq/α 是否正確"
             if abs(k_size - 1) > 0.08 else ""))
    ra, rb = ra0 * k_size, rb0 * k_size                    # 表觀半軸（全圖 px）
    ra_mm, rb_mm = ra / s, rb / s
    log(f"    顆粒：長軸 {2 * ra:.1f} px、短軸 {2 * rb:.1f} px；工作尺度 ×{sc:.3f}")

    # ---------------- [B][C] 逐幀偵測與追蹤 ----------------
    def to_full(det):
        f = det.copy()
        f[:, 0] = x0 + (det[:, 0] + 0.5) / sc - 0.5
        f[:, 1] = y0 + (det[:, 1] + 0.5) / sc - 0.5
        return f

    tracker = Tracker(2 * rb, alpha)
    rows, fstats = [], []
    cap.set(cv2.CAP_PROP_POS_FRAMES, f0)
    t0 = time.time()
    cam = np.zeros(2)                                      # 相機相對參考幀的位移（px）
    screw_pos = sinfo["ref_pos"].copy()
    for fi in range(f0, f1 + 1):
        ok, frame = cap.read()
        if not ok:
            f1 = fi - 1
            break
        # 影像穩定：逐幀找螺絲，相機被碰到時把畫面平移回參考幀的位置。
        # 螺絲被手遮住（相關係數低）時沿用上一幀的位移。
        loc = locate_screws(frame, sinfo["tpl"], screw_pos)
        if min(loc[0][2], loc[1][2]) > 0.6:
            screw_pos = np.array([l[:2] for l in loc])
            cam = (screw_pos - sinfo["ref_pos"]).mean(0)
        det, thr = detector.detect(to_work(crop_stable(frame, roi_box, cam)))
        dfull = to_full(det)
        ids = tracker.step(dfull[:, :3])
        for i in range(len(det)):
            rows.append((fi, ids[i], dfull[i, 0], dfull[i, 1], dfull[i, 2]))
        fstats.append((fi, len(det), thr, cam[0], cam[1]))
        done = fi - f0 + 1
        if done % 20 == 0:                                 # [v3] 每 20 幀回報一次進度
            report("偵測追蹤", done, n_est)
        if (fi - f0) % 200 == 0 and not QUIET:
            el = time.time() - t0
            # [v3] 多印百分比和預估剩餘時間
            print(f"    幀 {fi - f0}/{n_est}（{done / n_est:.0%}）：{len(det)} 顆，"
                  f"{el / done * 1000:.0f} ms/幀，預估還要 {fmt_dur(el / done * (n_est - done))}")
    cap.release()
    n_use = f1 - f0 + 1
    report("分析與輸出", n_est, n_est)                    # [v3]
    log(f"[B][C] 偵測+追蹤完成：{time.time() - t0:.0f} s")

    df = pd.DataFrame(rows, columns=["frame", "id", "x_px", "y_px", "theta_img"])
    if df.empty:
        raise RuntimeError("整支影片都沒有偵測到顆粒，請檢查 ROI 與筒倉四點")
    df = df.sort_values(["id", "frame"]).reset_index(drop=True)

    # 速度：對每條軌跡的 x(t)、y(t) 做 Savitzky-Golay 微分（視窗 ≈ 0.05 s）。
    # 比兩幀相減穩定得多，因為偵測的次像素誤差會被多點擬合平均掉。
    win = max(5, int(round(0.05 * fps)) | 1)
    vx, vy = np.zeros(len(df)), np.zeros(len(df))
    for _, idx in df.groupby("id").indices.items():
        for col, v in (("x_px", vx), ("y_px", vy)):
            y = df[col].to_numpy()[idx]
            if len(y) >= win:
                v[idx] = savgol_filter(y, win, 2, deriv=1)
            elif len(y) >= 2:
                v[idx] = np.gradient(y)
    df["t_sec"] = (df["frame"] - f0) / fps
    df["x_mm"], df["y_mm"] = silo.to_phys(df["x_px"], df["y_px"])
    vxm, vym = silo.vec_phys(vx, vy)
    df["vx_mm_s"], df["vy_mm_s"] = vxm * fps, vym * fps     # y 向上為正
    df["speed_mm_s"] = np.hypot(df["vx_mm_s"], df["vy_mm_s"])
    df["v_down_mm_s"] = -df["vy_mm_s"]                      # 向下為正
    df["theta_deg"] = 0.0 if alpha < 1.05 else silo.theta_phys(df["theta_img"])
    # 長軸指向：長軸與鉛直軸的夾角。鉛直 = 0°、長軸上端往右傾為正、往左傾為負，
    # 範圍 [-90°, +90°)。theta_deg 量的是長軸與水平 +x 軸的夾角（0–180°），
    # 兩者差 90°，再用 angdiff180 折回 180° 週期的主區間
    # （橢圓轉 180° 和原來一樣，所以水平會落在 −90°，與 +90° 等價）。
    # 只要統計「偏離鉛直多少」而不分左右傾，取 tilt_deg.abs() 即可。
    # 圓盤（α < 1.05）沒有可定義的長軸，一律填 NaN；
    # 不填 0 是為了避免被當成「長軸鉛直」混進角度統計裡。
    df["tilt_deg"] = (np.nan if alpha < 1.05
                      else angdiff180(90.0, df["theta_deg"].to_numpy()))

    # ---------------- [D] 筒倉內顆粒數 N(t) 與堵塞切分 ----------------
    # 顆粒在鉛直方向上伸出質心多遠（mm）。圓盤就是半徑；橢圓要看朝向。
    h_up = half_extent(ra_mm, rb_mm, df["theta_deg"].to_numpy(), 0.0, 1.0)
    df["y_top_mm"] = df["y_mm"] + h_up                      # 顆粒最高點
    v_move = V_MOVE_B_S * b_mm                              # 「有在動」的速度下限（以短軸 b 為準，速度統計用）
    # [v3] 筒倉內 = 顆粒最高點在出口線以上（只要有一部分還在筒倉內，就算筒倉內），
    #      而且這條軌跡活得夠久。舊版用「質心在出口線以上」，卡在出口、質心已經
    #      低於出口線的那顆會被漏算。
    # 加壽命門檻的理由：壓克力上的倒影、筒倉外的亮背景會被當成顆粒，而且常常
    # 閃一下就消失，每閃一次就是一條新的短軌跡。真顆粒一旦在筒倉內，會被連續
    # 追蹤數百幀，不可能只出現十幾幀。
    df["track_len"] = df.groupby("id")["frame"].transform("size")
    df["long_track"] = df["track_len"] >= MIN_TRACK_FRAMES
    df["in_silo_raw"] = df["y_top_mm"] >= 0                 # 未過濾壽命，保留下來供比對
    df["in_silo"] = df["in_silo_raw"] & df["long_track"]

    idx = pd.RangeIndex(f0, f1 + 1, name="frame")
    fr = pd.DataFrame(fstats, columns=["frame", "n_detected", "threshold",
                                       "cam_dx_px", "cam_dy_px"]).set_index("frame")
    fr = fr.reindex(idx)
    fr["n_detected"] = df.groupby("frame").size().reindex(idx).fillna(0).astype(int)
    fr["n_in_silo"] = df[df["in_silo"]].groupby("frame").size().reindex(idx).fillna(0).astype(int)
    fr["n_in_silo_raw"] = (df[df["in_silo_raw"]].groupby("frame").size()
                           .reindex(idx).fillna(0).astype(int))
    fr["n_short_track"] = fr["n_in_silo_raw"] - fr["n_in_silo"]   # 被壽命門檻濾掉幾顆
    fr = fr.reset_index()
    fr["t_sec"] = (fr["frame"] - f0) / fps

    # [v3] N(t) → 每一幀離開了幾顆。
    #   第 1 步：置中的滾動中位數，濾掉短暫的偵測閃爍（例如漏抓一兩幀）。
    #   第 2 步：平台值追蹤（count_drops）：平滑後的 N 比平台值少 → 有顆粒離開。
    N_smooth = (fr["n_in_silo"].rolling(COUNT_SMOOTH_FRAMES | 1, center=True, min_periods=1)
                .median().to_numpy())
    N_smooth = np.floor(N_smooth + 0.5)          # 視窗在影片頭尾變偶數長時中位數會是 .5，取整
    level, n_drop = count_drops(N_smooth, COUNT_RISE_FRAMES)
    fr["n_in_silo_smooth"] = N_smooth.astype(int)
    fr["n_level"] = level.astype(int)

    # 堵塞切分：連續 CLOG_FRAMES 幀都沒有顆粒離開 → 這一段是「沒有東西掉下來」。
    # 其中若筒倉內顆粒數已少於 EMPTY_N，代表是流光了，不是堵塞。
    killed_runs = []                             # 被抹掉的小流動段 (a, b)，見下面的迴圈

    def segment(drops):
        """把逐幀的離開顆數切成「堵塞段」與「流動段」。
        每段靜止期記下開頭存量 n_start 與結尾存量 n_end：
          一般的靜止期：兩個都是整段的中位數（和舊版一樣）。
          中間併過「只掉 1 顆」小流動段的靜止期：在小流動段處切開，
            n_start = 第一小段的中位數、n_end = 最後一小段的中位數。
        事件的掉落數 = 前一段靜止期的 n_end − 後一段靜止期的 n_start。"""
        quiet = drops == 0
        st = np.array(["flow"] * len(fr), dtype=object)
        cg = []
        nis = fr["n_in_silo"]
        for a, b, v in runs(quiet):
            if not v or (b - a + 1) < CLOG_FRAMES:
                continue
            n_med = float(nis.iloc[a:b + 1].median())
            kind = "empty" if n_med < EMPTY_N else "clog"
            st[a:b + 1] = kind
            # 這段靜止期裡面被併掉的小流動段，把靜止期切成幾小段
            inner = sorted((ka, kb) for ka, kb in killed_runs if a <= ka and kb <= b)
            pieces, p0 = [], a
            for ka, kb in inner:
                if ka > p0:
                    pieces.append((p0, ka - 1))
                p0 = kb + 1
            if p0 <= b:
                pieces.append((p0, b))
            if inner and pieces:
                n_start = float(nis.iloc[pieces[0][0]:pieces[0][1] + 1].median())
                n_end = float(nis.iloc[pieces[-1][0]:pieces[-1][1] + 1].median())
            else:
                n_start = n_end = n_med
            cg.append(dict(kind=kind, a=a, b=b, n_in_silo=n_med, n_start=n_start, n_end=n_end))
        return st, cg

    n_head = min(CLOG_FRAMES, len(fr))           # 影片開頭／結尾拿來量存量的幀數

    def plateaus(a, b, cg):
        """流動段 [a, b] 前後的存量 (N_before, N_after, 前一段靜止期, 後一段靜止期)。
        前面沒有靜止期 → 用影片開頭幾幀；後面沒有 → 用這段流動最後幾幀。"""
        prev = [c for c in cg if c["b"] < a]
        nxt = [c for c in cg if c["a"] > b]
        prev = prev[-1] if prev else None
        nxt = nxt[0] if nxt else None
        nis = fr["n_in_silo"]
        nb = prev["n_end"] if prev else float(nis.iloc[:n_head].median())
        na = nxt["n_start"] if nxt else float(nis.iloc[max(0, b - n_head):b + 1].median())
        return nb, na, prev, nxt

    # 存量差 < MIN_EVENT_DROP 的流動段視為雜訊或「只掉 1 顆」，抹掉後重切，
    # 直到沒有這種段為止。被抹掉的段會和前後的堵塞段併成一段長堵塞。
    # （只掉的那 1 顆不會被算進前後任何一個事件：前一個事件用的是
    #   這段長堵塞「第一小段」的存量，後一個事件用的是「最後一小段」的存量。）
    state, clogs = segment(n_drop)
    killed = 0
    while True:
        bad = [(a, b) for a, b, v in runs(state == "flow")
               if v and (lambda p: p[0] - p[1])(plateaus(a, b, clogs)) < MIN_EVENT_DROP]
        if not bad:
            break
        for a, b in bad:
            n_drop[a:b + 1] = 0
        killed_runs.extend(bad)
        killed += len(bad)
        state, clogs = segment(n_drop)
    # 起點修正：堵塞剛要破的時候，顆粒開始晃動，偵測偶爾漏抓一顆，N 會先閃一下
    # 「少 1 顆」又回來，流動段的起點因此被提前（實測 IMG_0109 提前了 27 幀）。
    # 掉落數不受影響（用的是前後靜止期的存量），但持續時間和流率會被拉長。
    # 做法：在流動段裡找「平滑後的 N 最後一次還等於流動前存量」的那一幀，
    # 真正的流動從它的下一幀開始，前面那幾幀併回前一段堵塞。
    for a, b, v in runs(state == "flow"):
        if not v:
            continue
        nb, _, prev, _ = plateaus(a, b, clogs)
        if prev is None:                         # 影片一開始就在流動：沒有可以併回去的堵塞段
            continue
        back = np.nonzero(N_smooth[a:b + 1] >= nb)[0]
        if len(back) and back[-1] < b:
            t = a + int(back[-1])
            state[a:t + 1] = prev["kind"]
            n_drop[a:t + 1] = 0                  # 那一下閃爍不算離開
            prev["b"] = t
    fr["n_drop"] = n_drop
    fr["n_drop_cum"] = fr["n_drop"].cumsum()   # 只供參考；掉落數 s 以存量差為準
    fr["state"] = state

    # ---------------- [E] 掉落數／剩餘數／P_c ----------------
    # 事件 = 兩段「沒有東西掉」之間的流動期。
    # 掉落數 s_count = 前一段靜止期結尾的筒倉內顆粒數 − 後一段靜止期開頭的顆粒數
    # （用中位數，靜止期數得最準）。[v3] 穿線計數 s_exit 已移除。
    clog_only = [c for c in clogs if c["kind"] == "clog"]
    events = []
    for a, b, v in runs((fr["state"] == "flow").to_numpy()):
        if not v:
            continue
        # [v3] 前後存量統一由 plateaus() 給（和上面抹掉小事件時用的是同一套算法）。
        #      第一筆前面沒有堵塞 → 用影片開頭幾幀；影片在流動中結束 → 用最後幾幀。
        N_before, N_after, prev, nxt = plateaus(a, b, clogs)
        events.append(dict(
            event_id=len(events),
            start_frame=int(fr["frame"].iloc[a]), end_frame=int(fr["frame"].iloc[b]),
            duration_s=(b - a + 1) / fps,
            s_count=N_before - N_after,                      # 存量差
            N_before=N_before, N_after=N_after,
            is_first_flow=len(events) == 0,                  # 這支影片的第一筆流出
            preceded_by_clog=prev is not None,               # 前面有被堵塞夾住
            # 最後一次流出：後面沒有堵塞，而是流光或影片結束 → 真值其實是 s ≥ 觀測值
            is_last_censored=(nxt is None) or (nxt["kind"] == "empty"),
        ))
    ev = pd.DataFrame(events, columns=["event_id", "start_frame", "end_frame", "duration_s",
                                       "s_count", "N_before", "N_after",
                                       "is_first_flow", "preceded_by_clog", "is_last_censored"])
    # 第一筆的「前一次堵塞」發生在開拍前，所以它的 N_before 是從影片開頭量的，
    # 不是從錄到的堵塞期量的。這一欄把這件事記下來，之後看數據才知道差別。
    ev["N_before_from_video_start"] = ev["is_first_flow"] & (~ev["preceded_by_clog"])
    # 流率（顆/s）= 掉落數 ÷ 這次流動的持續時間。
    #   rate_count：用存量差 s_count。整支影片的總數守恆，漏算最少。
    # 注意：單筆事件常常只有零點幾秒，逐筆流率的誤差很大；
    #       要和 Beverloo 比，請用 summary 裡的「合併流率」或「回歸斜率」。
    ev["rate_count"] = ev["s_count"] / ev["duration_s"]
    # 「可用」= 兩端都被堵塞夾住、而且掉落數為正。
    # 最後一筆是刪失資料（流光了，堵塞沒發生），納入會低估 <s>，所以一律排除。
    # 影片開始後的第一筆流出則另外處理：它仍然符合 s 的定義
    #   （s = 一次破拱到再次堵塞之間流出的顆粒數），
    # 只是它前面那次堵塞是開拍前形成的，過程沒有錄到，所以單獨標成 "first"。
    ev["is_valid"] = (ev["preceded_by_clog"] & (~ev["is_last_censored"])
                      & (ev["s_count"] > 0))

    def label(r):
        """每一筆事件歸成一類，方便在 CSV 裡直接篩。"""
        if r["is_last_censored"]:
            return "last_censored"       # 最後一次流出：流光了，真值是 s ≥ 觀測值
        if not r["is_valid"]:
            return "excluded"            # 前面沒有堵塞，或掉落數 ≤ 0
        return "first" if r["is_first_flow"] else "normal"

    ev["event_type"] = ev.apply(label, axis=1) if len(ev) else pd.Series(dtype=object)
    ev["used_for_Pc"] = ev["is_valid"] & (~(DROP_FIRST_EVENT & ev["is_first_flow"]))

    def pc(sub, col):
        m = sub[col].mean() if len(sub) else np.nan
        return float(1.0 / m) if len(sub) and m > 0 else np.nan

    # 三個集合都算，這樣「第一筆要不要算」不必在跑程式前就決定
    norm = ev[ev["event_type"] == "normal"]
    first = ev[ev["event_type"] == "first"]
    both = ev[ev["event_type"].isin(["first", "normal"])]
    P_c_normal, P_c_both = pc(norm, "s_count"), pc(both, "s_count")
    use = ev[ev["used_for_Pc"]]
    P_c = pc(use, "s_count")
    ev["P_c"] = P_c
    s_first = float(first["s_count"].iloc[0]) if len(first) else np.nan

    # 整支影片的流率。流率不受「最後一筆是刪失」影響（顆粒照樣在流），
    # 所以這裡用全部事件，不套 P_c 的篩選。
    #   合併流率 = 總掉落數 ÷ 總流動時間（短事件的雜訊會互相抵消）
    #   回歸斜率 = s 對持續時間做直線擬合的斜率（扣掉每次起流的暫態，最接近穩態流率）
    T_flow = float(ev["duration_s"].sum()) if len(ev) else 0.0
    Q_count = float(ev["s_count"].sum() / T_flow) if T_flow > 0 else np.nan
    Q_mean = float(ev["rate_count"].mean()) if len(ev) else np.nan
    Q_sem = float(ev["rate_count"].std() / np.sqrt(len(ev))) if len(ev) > 1 else np.nan
    if len(ev) >= 3 and ev["duration_s"].nunique() > 1:
        Q_slope, Q_icpt = (float(v) for v in np.polyfit(ev["duration_s"], ev["s_count"], 1))
    else:
        Q_slope, Q_icpt = np.nan, np.nan

    # 「最早開始的堵塞」= 第一段被判定為 clog 的靜止期，另外標出來
    first_clog_id = next((i for i, c in enumerate(clogs) if c["kind"] == "clog"), None)
    cl = pd.DataFrame([dict(clog_id=i, kind=c["kind"],
                            start_frame=int(fr["frame"].iloc[c["a"]]),
                            end_frame=int(fr["frame"].iloc[c["b"]]),
                            duration_s=(c["b"] - c["a"] + 1) / fps,
                            n_remaining=c["n_in_silo"],
                            is_first_clog=(i == first_clog_id))
                      for i, c in enumerate(clogs)],
                     columns=["clog_id", "kind", "start_frame", "end_frame",
                              "duration_s", "n_remaining", "is_first_clog"])

    # 把事件編號貼回逐幀表
    eid = np.full(len(fr), -1)
    for e in events:
        m = (fr["frame"] >= e["start_frame"]) & (fr["frame"] <= e["end_frame"])
        eid[m.to_numpy()] = e["event_id"]
    fr["event_id"] = eid

    # ---------------- [C 續] 速度統計 ----------------
    # 只取「流動期間、ROI 內、往下移動」的顆粒；靜止期的速度是量測雜訊，
    # 混進來會在 v ≈ 0 疊出一根假的尖峰，所以不納入。
    df = df.merge(fr[["frame", "state", "event_id"]], on="frame", how="left")
    vel = df[(df["state"] == "flow") & (df["v_down_mm_s"] > 0)][
        ["frame", "t_sec", "id", "x_mm", "y_mm", "v_down_mm_s", "event_id"]].copy()
    # moving 旗標：速度低於 V_MOVE_B_S × b（預設 0.5 b/s）的多半是靜止顆粒的量測雜訊，
    # 這裡不先刪掉（刪了 P(v) 的低速端就被切掉），只標起來讓你之後自己決定。
    vel["moving"] = vel["v_down_mm_s"] > v_move
    # y_mm 保留著：之後若要對齊 Zhang 的「出口上方 4·d_eq」，直接篩 y_mm <= 4*d_eq 即可

    # ---------------- [F] 輸出 ----------------
    fr.to_csv(os.path.join(out_dir, "frames.csv"), **ENC)
    ev_cols = ["event_id", "event_type", "start_frame", "end_frame", "duration_s",
               "s_count", "rate_count",
               "N_before", "N_after", "used_for_Pc", "P_c",
               "is_first_flow", "preceded_by_clog", "is_last_censored", "is_valid",
               "N_before_from_video_start"]
    ev[[c for c in ev_cols if c in ev.columns]].to_csv(
        os.path.join(out_dir, "events.csv"), **ENC)
    cl.to_csv(os.path.join(out_dir, "clogs.csv"), **ENC)
    vel.to_csv(os.path.join(out_dir, "velocities.csv"), **ENC)
    # 長軸指向：每顆每幀一列，不受 state 篩選（靜止期、堵塞期、出口下方的顆粒都收）。
    # state / event_id / in_silo / long_track 一起帶出來，之後要只看流動期、
    # 只看筒倉內、或只看長軌跡，都可以直接在這張表上篩，不必回頭改程式。
    ori = df[["frame", "t_sec", "id", "x_mm", "y_mm",
              "theta_deg", "tilt_deg", "in_silo", "long_track",
              "state", "event_id"]].copy()
    ori.to_csv(os.path.join(out_dir, "orientations.csv"), **ENC)
    if SAVE_DETECTIONS:
        df.to_csv(os.path.join(out_dir, "detections.csv"), **ENC)
    plot_count_trace(fr, ev, fps, os.path.join(out_dir, "count_trace.png"),
                     f"{cfg['video']}  α={alpha}")                # [v3] N(t) 診斷圖

    cm = np.hypot(fr["cam_dx_px"], fr["cam_dy_px"])
    log(f"[A] 相機晃動（已補償）：最大 {cm.max() / s:.2f} mm")
    nd = fr["n_detected"]
    log(f"[B] 每幀偵測數：中位 {nd.median():.0f}、最少 {nd.min()}、最多 {nd.max()}"
        f"（初始設定 {n_init} 顆）")
    tl = df.groupby("id")["frame"].size()
    log(f"[C] 軌跡壽命門檻 {MIN_TRACK_FRAMES} 幀："
        f"{int((tl < MIN_TRACK_FRAMES).sum())}/{len(tl)} 條軌跡不計入筒倉內顆粒數；"
        f"每幀平均濾掉 {fr['n_short_track'].mean():.2f} 顆")
    vm = vel[vel["moving"]]
    log(f"[C] 流動期間向下移動的顆粒速度：{len(vel)} 筆（其中 moving={len(vm)} 筆）")
    if len(vm):
        q = vm["v_down_mm_s"].quantile([0.25, 0.5, 0.75])
        log(f"    moving 的中位 {q[0.5]:.1f} mm/s、四分位 {q[0.25]:.1f}–{q[0.75]:.1f}、"
            f"最大 {vm['v_down_mm_s'].max():.1f} mm/s")
    log(f"[D] 狀態分佈：流動 {(fr['state'] == 'flow').sum()} 幀、"
        f"堵塞 {(fr['state'] == 'clog').sum()} 幀、流光 {(fr['state'] == 'empty').sum()} 幀；"
        f"堵塞 {len(clog_only)} 次")
    log(f"    [v3] 以 N(t) 判斷：平滑視窗 {COUNT_SMOOTH_FRAMES} 幀；"
        f"存量差 < {MIN_EVENT_DROP} 顆而被併回堵塞的流動段 {killed} 段")
    name = {"first": "第一筆（前一次堵塞在開拍前）", "normal": "",
            "last_censored": "最後一次流出（刪失，真值 s ≥ 觀測值）",
            "excluded": "不納入"}
    log(f"[E] 事件 {len(ev)} 筆：first {len(first)}、normal {len(norm)}、"
        f"last_censored {int((ev['event_type'] == 'last_censored').sum())}、"
        f"excluded {int((ev['event_type'] == 'excluded').sum())}")
    for _, e in ev.iterrows():
        tag = name[e.event_type]
        log(f"    事件 {int(e.event_id)} [{e.event_type:>13}]："
            f"幀 {int(e.start_frame)}–{int(e.end_frame)}（{e.duration_s:.2f} s） "
            f"掉落 {e.s_count:.0f} 顆 剩餘 {e.N_after:.0f} 顆 "
            f"流率 {e.rate_count:.0f} 顆/s"
            + (f"  ← {tag}" if tag else ""))
    if np.isfinite(s_first):
        log(f"    第一筆的 s = {s_first:.0f} 顆")
    # 兩種算法都給：第一筆要不要算進去，留給分析階段決定
    if np.isfinite(P_c_normal):
        log(f"    只用 normal（{len(norm)} 筆）：<s> = {norm['s_count'].mean():.1f}，"
            f"P_c = {P_c_normal:.4f}，相對標準誤 ≈ {1 / np.sqrt(len(norm)):.0%}")
    if np.isfinite(P_c_both):
        log(f"    含第一筆（{len(both)} 筆）：<s> = {both['s_count'].mean():.1f}，"
            f"P_c = {P_c_both:.4f}，相對標準誤 ≈ {1 / np.sqrt(len(both)):.0%}")
    if np.isfinite(P_c):
        log(f"    目前 DROP_FIRST_EVENT = {DROP_FIRST_EVENT} → 採用 P_c = {P_c:.4f}"
            f"（{len(use)} 筆）")
    else:
        log("    沒有可用的 堵塞→流動→堵塞 事件，無法計算 P_c")
    if np.isfinite(Q_count):
        log(f"[E] 流率（全部 {len(ev)} 筆事件，流動共 {T_flow:.2f} s）")
        log(f"    合併流率（總掉落數 ÷ 總流動時間）：{Q_count:.1f} 顆/s")
        if np.isfinite(Q_sem):
            log(f"    逐筆平均：存量法 {Q_mean:.1f} ± {Q_sem:.1f} 顆/s"
                f"（事件很短時這個數字不穩，僅供參考）")
        if np.isfinite(Q_slope):
            log(f"    s 對持續時間的回歸斜率：{Q_slope:.1f} 顆/s（截距 {Q_icpt:.1f} 顆）")

    if do_overlay:                                           # [v2] 由呼叫端決定
        report("輸出追蹤影片", n_est, n_est)                  # [v3]
        t_ov = time.time()
        write_overlay(video_path, os.path.join(out_dir, "overlay.mp4"), df, fr, ev, silo,
                      (x0, y0, x1, y1), ra, rb, f0, f1, fps, alpha, v_move)
        log(f"[F] 追蹤影片 overlay.mp4 完成：{time.time() - t_ov:.0f} s")

    summary = dict(video=cfg["video"], alpha=alpha, d_eq_mm=d_eq, n_initial=n_init,
                   fps=fps, start_frame=f0, end_frame=f1, px_per_mm=s,
                   outlet_width_mm=silo.D_mm, n_clogs=len(clog_only), n_events=len(ev),
                   n_events_for_Pc=int(ev["used_for_Pc"].sum()),
                   mean_s_count=float(use["s_count"].mean()) if len(use) else np.nan,
                   P_c=P_c,
                   # 第一筆單獨列出，以及「不含／含第一筆」兩種 P_c
                   s_first=s_first, n_normal=len(norm),
                   mean_s_normal=float(norm["s_count"].mean()) if len(norm) else np.nan,
                   P_c_normal_only=P_c_normal,
                   n_with_first=len(both), P_c_with_first=P_c_both,
                   total_s_count=float(ev["s_count"].sum()),
                   # 流率（顆/s）：合併、逐筆平均、回歸斜率；穿線法只當對照
                   total_flow_time_s=T_flow,
                   flow_rate_count=Q_count,
                   flow_rate_count_event_mean=Q_mean, flow_rate_count_event_sem=Q_sem,
                   flow_rate_count_slope=Q_slope, flow_rate_count_intercept=Q_icpt,
                   channel=channel,
                   n_detected_median=float(fr["n_detected"].median()),
                   first_clog_frame=int(cl.loc[cl["is_first_clog"], "start_frame"].iloc[0])
                   if bool(cl["is_first_clog"].any()) else -1,
                   last_event_s_count=float(ev.loc[ev["is_last_censored"], "s_count"].iloc[-1])
                   if bool(ev["is_last_censored"].any()) else np.nan,
                   median_v_down_mm_s=float(vm["v_down_mm_s"].median()) if len(vm) else np.nan,
                   # [v2] QC 欄位（原本只印在 summary.txt 裡）
                   b_mm=float(b_mm), px_per_mm_template=float(s_tpl),
                   screw_corr=float(sinfo["corr"]), screw_sd_px=float(sinfo["sd_px"]),
                   screw_n=int(sinfo["n"]), k_size=float(k_size),
                   half_angle_deg=float(np.mean(silo.half_angles)), roll_deg=float(silo.roll),
                   cam_shake_max_mm=float(cm.max() / s), n_detected_max=int(nd.max()),
                   N_first=float(fr["n_in_silo"].iloc[:n_head].median()),
                   n_empty_frames=int((fr["state"] == "empty").sum()),
                   end_class_label=cfg.get("end_class", ""),
                   legacy_scale=bool(legacy_scale))
    return out_dir, ev.assign(video=cfg["video"]), summary


