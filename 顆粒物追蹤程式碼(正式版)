SEARCH_PAD = 26           # 螺絲逐幀搜尋範圍：上一幀位置 ±(模板半寬 + 這個值) px


def locate_screws(bgr, tpl, centers, half=32, pad=SEARCH_PAD):
    """在 centers 附近用正規化互相關找回兩顆螺絲，回傳 [(x, y, 相關係數)]。
    TM_CCOEFF_NORMED 會先扣掉平均亮度，所以對照明變化不敏感。
    搜尋範圍只開 ±(half + pad)：相機是逐幀追蹤的，位移不會一次跳太多，
    範圍開小一點可以省掉大部分的相關運算時間。"""
    loc = []
    for (cx, cy), t in zip(centers, tpl):
        xi, yi = int(round(cx)), int(round(cy))
        x0, y0 = max(0, xi - half - pad), max(0, yi - half - pad)
        sub = bgr[y0:yi + half + pad, x0:xi + half + pad]
        gray = sub if sub.ndim == 2 else cv2.cvtColor(sub, cv2.COLOR_BGR2GRAY)
        if gray.shape[0] < t.shape[0] or gray.shape[1] < t.shape[1]:
            loc.append((cx, cy, 0.0))
            continue
        r = cv2.matchTemplate(gray, t, cv2.TM_CCOEFF_NORMED)
        _, mv, _, (i, j) = cv2.minMaxLoc(r)
        dx = parabolic(r[j, i - 1], r[j, i], r[j, i + 1]) if 0 < i < r.shape[1] - 1 else 0
        dy = parabolic(r[j - 1, i], r[j, i], r[j + 1, i]) if 0 < j < r.shape[0] - 1 else 0
        loc.append((x0 + i + dx + half, y0 + j + dy + half, mv))
    return loc


def screw_scale(cap, f0, f1, pts, screw_mm, half=32):
    """兩顆螺絲 → px/mm，並回傳螺絲模板（之後逐幀追蹤相機晃動用）。
    以點選位置切模板，在 25 個均勻取樣幀上重新定位，取兩心間距的中位數。
    相機微震會讓兩顆一起動，相減就抵銷，所以間距比單顆位置穩定。"""
    ref = cv2.cvtColor(read_frame(cap, f0), cv2.COLOR_BGR2GRAY)
    H, W = ref.shape
    tpl, ctr = [], []
    for x, y in pts:
        xi, yi = int(round(x)), int(round(y))
        if not (half <= xi < W - half and half <= yi < H - half):
            raise RuntimeError("螺絲太靠近畫面邊緣，切不出模板")
        tpl.append(ref[yi - half:yi + half, xi - half:xi + half].copy())
        ctr.append((xi, yi))
    ref_pos = np.array([l[:2] for l in locate_screws(ref, tpl, ctr, half)])
    dists, corr = [], []
    for fi in np.linspace(f0, f1, 25).astype(int):
        f = read_frame(cap, fi)
        if f is None:
            continue
        loc = locate_screws(cv2.cvtColor(f, cv2.COLOR_BGR2GRAY), tpl, ctr, half)
        if min(loc[0][2], loc[1][2]) > 0.6:
            dists.append(np.hypot(loc[1][0] - loc[0][0], loc[1][1] - loc[0][1]))
            corr.append(min(loc[0][2], loc[1][2]))
    if len(dists) < 5:
        raise RuntimeError("螺絲在多數幀都對不上模板，請重新標定螺絲十字中心")
    d = np.array(dists)
    return float(np.median(d)) / screw_mm, dict(
        n=len(d), dist_px=float(np.median(d)), sd_px=float(d.std()),
        corr=float(np.median(corr)), tpl=tpl, ctr=ctr, ref_pos=ref_pos)


class Silo:
    """四個標定點 → 壁線、出口、物理座標（含相機傾斜校正）、筒倉遮罩。
    物理座標：原點 = 出口中點，x 向右，y 向上，單位 mm。"""

    def __init__(self, pts, s):
        self.LT, self.LB, self.RB, self.RT = [np.asarray(p, float) for p in pts]
        self.s = s                                   # px/mm
        self.o = (self.LB + self.RB) / 2.0           # 出口中點（影像座標）
        self.D_mm = float(np.linalg.norm(self.RB - self.LB) / s)

        def up(top, bot):   # 壁「由下往上」的單位向量，換成 y 向上的座標
            v = np.array([top[0] - bot[0], bot[1] - top[1]])
            return v / np.linalg.norm(v)
        uL, uR = up(self.LT, self.LB), up(self.RT, self.RB)
        bis = (uL + uR) / np.linalg.norm(uL + uR)    # 兩壁的對稱軸 = 真正的鉛直方向
        self.roll = float(np.degrees(np.arctan2(-bis[0], bis[1]))) if ROLL_CORRECT else 0.0
        c, sn = np.cos(np.radians(-self.roll)), np.sin(np.radians(-self.roll))
        self.Rm = np.array([[c, -sn], [sn, c]])      # 把對稱軸轉成鉛直的旋轉矩陣
        self.half_angles = [float(np.degrees(np.arccos(np.clip(u @ bis, -1, 1))))
                            for u in (uL, uR)]       # 校正後兩壁與鉛直的夾角（設計值 30°）
        self.n = {}                                  # 兩面壁的「向內」單位法向量
        for side, (p, q) in (("left", (self.LT, self.LB)), ("right", (self.RT, self.RB))):
            u = (q - p) / np.linalg.norm(q - p)
            nv = np.array([-u[1], u[0]])
            self.n[side] = (p, nv if (self.o - p) @ nv > 0 else -nv)

    def to_phys(self, x, y):
        """影像 px → 物理 mm。"""
        q = np.stack([np.asarray(x, float) - self.o[0], self.o[1] - np.asarray(y, float)])
        p = self.Rm @ q.reshape(2, -1) / self.s
        return p[0], p[1]

    def vec_phys(self, vx, vy):
        """影像中的向量（px/幀）→ 物理向量（mm/幀）。y 向上為正。"""
        p = self.Rm @ np.stack([np.asarray(vx, float), -np.asarray(vy, float)]).reshape(2, -1)
        return p[0] / self.s, p[1] / self.s

    def theta_phys(self, th_img):
        """影像中的長軸角度（由 +x 往下為正）→ 物理角度（由 +x 逆時針為正）。"""
        return (-np.asarray(th_img) - self.roll) % 180.0

    def wall_dist(self, x, y, side):
        """質心到壁線的垂直距離（px，向內為正）。"""
        p, nv = self.n[side]
        return (np.asarray(x, float) - p[0]) * nv[0] + (np.asarray(y, float) - p[1]) * nv[1]

    def mask(self, x0, y0, x1, y1, margin_px, below_px):
        """ROI 內的筒倉遮罩（uint8 0/1）：壁外一律排除；
        出口線以下多留 below_px，讓正在掉出去的顆粒還追得到。"""
        yy, xx = np.mgrid[y0:y1, x0:x1].astype(np.float32)
        xp, yp = self.to_phys(xx.ravel(), yy.ravel())
        xp, yp = xp.reshape(xx.shape), yp.reshape(xx.shape)
        inside = ((self.wall_dist(xx, yy, "left") >= -margin_px) &
                  (self.wall_dist(xx, yy, "right") >= -margin_px))
        above = yp >= 0
        below = (~above) & (yp >= -below_px / self.s) & \
                (np.abs(xp) <= self.D_mm / 2 + margin_px / self.s)
        return ((inside & above) | below).astype(np.uint8)


def get_channel(bgr, which):
    """取單一顏色通道。顆粒是淺棕色、背景是黑布，LAB 的 b 通道通常分得最開。"""
    if which == "r":
        return bgr[:, :, 2]
    if which == "lab_b":
        return cv2.cvtColor(bgr, cv2.COLOR_BGR2LAB)[:, :, 2]
    return cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY)


def otsu_eta(vals):
    """Otsu 的可分離度 η = 類間變異 / 總變異（0~1，越大代表前景背景分得越開）。"""
    vals = vals.astype(np.float32)
    if vals.size < 50:
        return 0.0
    t, _ = cv2.threshold(vals.astype(np.uint8).reshape(-1, 1), 0, 255,
                         cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    lo, hi = vals[vals <= t], vals[vals > t]
    if len(lo) < 10 or len(hi) < 10 or vals.var() < 1e-6:
        return 0.0
    w0, w1 = len(lo) / len(vals), len(hi) / len(vals)
    return float(w0 * w1 * (lo.mean() - hi.mean()) ** 2 / vals.var())


def off_pile_count(X, Y, link_px):
    """回傳「沒有連到最大那一叢」的偵測數量。
    物理依據：靜止料堆裡的顆粒一定互相接觸，整堆是連通的。筒倉外的亮背景、
    壓克力上的倒影被誤判成顆粒時，會在料堆之外另外長出一小叢或散點，
    和主料堆不連通。所以「沒連到主料堆的偵測數」就是誤判量的直接估計，
    不需要人工標註答案。"""
    n = len(X)
    if n < 2:
        return 0
    d = np.hypot(X[:, None] - X[None, :], Y[:, None] - Y[None, :])
    adj = d < link_px
    lab = np.full(n, -1)
    cur = 0
    for i in range(n):                       # 簡單的廣度優先走訪，找連通分量
        if lab[i] >= 0:
            continue
        stack, lab[i] = [i], cur
        while stack:
            j = stack.pop()
            for k in np.nonzero(adj[j] & (lab < 0))[0]:
                lab[k] = cur
                stack.append(k)
        cur += 1
    return int(n - np.bincount(lab).max())


def choose_channel(samples, mask_w, make_det, to_phys_xy, link_px):
    """挑顏色通道。判準是「離群偵測率」最低，而不是 Otsu 可分離度最高。

    為什麼不用 Otsu 可分離度：它衡量的是「前景和背景分得開不開」，而畫面裡
    最強的對比是顆粒 vs 黑布，所以 R 通道分數最高。但 R 通道同時也把筒倉外
    的淺色牆面、鋁架算成前景，於是在壁的邊緣長出一整排假顆粒。
    LAB 的 b 通道量的是「黃-藍」，木片顆粒偏黃、牆面和金屬是中性色，
    所以它才是真正能把顆粒和亮背景分開的通道。

    直接用離群率當判準，就不必預設哪個通道比較好，換了照明或換了顆粒顏色
    也會自動挑對。另外加一道保險：偵測數明顯比最佳者少的通道不納入考慮，
    免得挑到一個「什麼都偵測不到所以離群率是 0」的通道。
    """
    stat = {}
    for c in ("r", "lab_b", "gray"):
        det = make_det(c)
        det.set_floor(samples)
        cnt, off = [], []
        for w in samples:
            D, _ = det.detect(w)
            if len(D) == 0:
                cnt.append(0)
                continue
            X, Y = to_phys_xy(D)
            keep = Y >= 0                    # 只看筒倉內；出口下方掉落中的本來就離群
            cnt.append(int(keep.sum()))
            off.append(off_pile_count(D[keep, 0], D[keep, 1], link_px))
        stat[c] = (float(np.median(cnt)),
                   float(np.sum(off)) / max(1.0, float(np.sum(cnt))),
                   float(np.min([otsu_eta(get_channel(f, c)[mask_w > 0]) for f in samples])))
    # 保險門檻放在 0.85：誤判多的通道「偵測數」本來就被假顆粒灌水，
    # 門檻訂太高反而會把乾淨的通道擋掉（實測 IMG_0002 就是這樣）。
    # 排序先看離群率（取到 0.1 個百分點），離群率相同才比偵測數，
    # 這樣既不會挑到幾乎偵測不到東西的通道，也不會被灌水的數字騙過去。
    best_cnt = max(v[0] for v in stat.values())
    ok = {c: v for c, v in stat.items() if v[0] >= 0.85 * best_cnt} or stat
    pick = min(ok, key=lambda c: (round(ok[c][1], 3), -ok[c][0]))
    return pick, stat


